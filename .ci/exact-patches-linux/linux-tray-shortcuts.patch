+/// `attributes` placed at the tray's item: centred on `click` (logical
+/// pixels, the tray's), `width` wide, kept `GAP` inside the screen's sides.
+/// A click in the screen's top half hangs it below the top bar, with an
+/// arrow up to the item; one in its bottom half (a bottom panel) stands it
+/// above the panel, with an arrow down. `height` is the page's: the arrow
+/// adds to it. With no click (a tray that gives no point) it hangs `RISE`
+/// below the top bar at the primary screen's right, where the tray's items
+/// are, with no arrow.
+fn at_item(
+    events: &ActiveEventLoop,
+    attributes: WindowAttributes,
+    click: Option<(i32, i32)>,
+    width: f64,
+    height: f64,
+) -> (WindowAttributes, Option<Arrow>) {
+    let area = |monitor: winit::monitor::MonitorHandle| {
+        let scale = monitor.scale_factor();
+        let at = monitor.position().to_logical::<f64>(scale);
+        let size = monitor.size().to_logical::<f64>(scale);
+        (at.x, at.y, size.width, size.height, scale)
+    };
+    let screen = match click {
+        Some((x, y)) => {
+            let (x, y) = (f64::from(x), f64::from(y));
+            events
+                .available_monitors()
+                .map(area)
+                .find(|(sx, sy, sw, sh, _)| {
+                    (*sx..sx + sw).contains(&x) && (*sy..sy + sh).contains(&y)
+                })
+        }
+        None => events
+            .primary_monitor()
+            .or_else(|| events.available_monitors().next())
+            .map(area),
+    };
+    let Some((start, screen_top, across, tall, scale)) = screen else {
+        return (attributes, None);
+    };
+    let work = work_area(scale);
+    let Some((x, y)) = click.map(|(x, y)| (f64::from(x), f64::from(y))) else {
+        let top = work.map_or(screen_top + GAP, |(bar, _)| bar + RISE);
+        let left = start + across - width - GAP;
+        return (attributes.with_position(LogicalPosition::new(left, top)), None);
+    };
+    let left = (x - width / 2.)
+        .min(start + across - width - GAP)
+        .max(start + GAP);
+    let down = y > screen_top + tall / 2.;
+    let whole = height + ARROW_HEIGHT;
+    let top = if down {
+        // The arrow's tip above the bottom panel, or above the click.
+        let bottom = match work.filter(|(_, floor)| *floor < y) {
+            Some((_, floor)) => floor - TIP,
+            None => y - GAP,
+        };
+        bottom - whole
+    } else {
+        match work.filter(|(bar, _)| *bar > y) {
+            Some((bar, _)) => bar + TIP,
+            None => y + GAP,
+        }
+    };
+    // The tip at the item, kept clear of the window's rounded corners.
+    let margin = f64::from(RADIUS) + ARROW_BASE / 2.;
+    let tip = (x - left).clamp(margin.min(width / 2.), (width - margin).max(width / 2.));
+    let attributes = attributes.with_position(LogicalPosition::new(left, top));
+    (attributes, Some(Arrow { x: tip, down }))
+}
