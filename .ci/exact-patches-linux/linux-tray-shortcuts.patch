+/// The page's pixels (RGBA) as the tray's window shows them, premultiplied
+/// ARGB for a transparent X11 window: GNOME's popup menu's shape, its
+/// corners rounded and clear outside, with its border inside the edge.
+/// The window is `size` (pixels), the page `size`'s width and as tall as
+/// `rgba` holds, from row `page_top`. `arrow`, the tip's distance from the
+/// window's left (pixels) and whether it points down, joins a wedge to the
+/// page's top or bottom edge in the rows the page leaves, filled with the
+/// page's colour at that edge and bordered as the rest is.
+fn popup_pixels(
+    out: &mut [u32],
+    rgba: &[u8],
+    size: (u32, u32),
+    page_top: u32,
+    scale: f32,
+    border: [u8; 3],
+    arrow: Option<(f32, bool)>,
+) {
+    let (width, height) = size;
+    let pixels = rgba.as_chunks::<4>().0;
+    let page_rows = (pixels.len() as u32 / width.max(1)).min(height - page_top);
+    let w = width as f32;
+    let (top, bottom) = (page_top as f32, (page_top + page_rows) as f32);
+    let h = bottom - top;
+    let radius = (RADIUS * scale).min(w / 2.).min(h / 2.);
+    let line = (BORDER * scale).max(1.);
+    // The wedge: its tip, and its two sides' outward normals, unit length.
+    let wedge = arrow.map(|(x, down)| {
+        let rise = height as f32 - h;
+        let half = ARROW_BASE as f32 * scale / 2.;
+        let length = (rise * rise + half * half).sqrt();
+        let (tip, flip) = if down { (bottom + rise, 1.) } else { (top - rise, -1.) };
+        let left = (-rise / length, flip * half / length);
+        let right = (rise / length, flip * half / length);
+        (x, tip, left, right, down)
+    });
+    // The arrow's fill: the page's colour just inside the edge it leaves.
+    let fill = wedge.map(|(x, _, _, _, down)| {
+        let col = (x as u32).min(width - 1);
+        let inset = (line.ceil() as u32 + 1).min(page_rows - 1);
+        let row = if down { page_rows - 1 - inset } else { inset };
+        pixels[(row * width + col) as usize]
+    });
+    for (i, out) in out.iter_mut().enumerate().take((width * height) as usize) {
+        let (col, row) = (i as u32 % width, i as u32 / width);
+        let (x, y) = (col as f32 + 0.5, row as f32 + 0.5);
+        // How far inside the rounded edge: positive within the shape.
+        let dx = (radius - x).max(x - (w - radius)).max(0.);
+        let dy = (top + radius - y).max(y - (bottom - radius)).max(0.);
+        let mut inside = if dx > 0. && dy > 0. {
+            radius - (dx * dx + dy * dy).sqrt()
+        } else {
+            x.min(w - x).min((y - top).min(bottom - y))
+        };
+        // The wedge, open at its base, so no border runs across it; it
+        // reaches only past the border into the page, clear of its corners.
+        let reach = line + 2.;
+        let near = |down: bool| if down { y >= bottom - reach } else { y <= top + reach };
+        if let Some((ax, ty, left, right, _)) = wedge.filter(|w| near(w.4)) {
+            let (px, py) = (x - ax, y - ty);
+            let side = |(nx, ny): (f32, f32)| -(nx * px + ny * py);
+            inside = inside.max(side(left).min(side(right)));
+        }
+        let cover = (inside + 0.5).clamp(0., 1.);
+        if cover <= 0. {
+            *out = 0;
+            continue;
+        }
+        let px = match row.checked_sub(page_top).filter(|r| *r < page_rows) {
+            Some(r) => pixels[(r * width + col) as usize],
+            None => fill.unwrap_or([0; 4]),
+        };
+        let edge = (line + 0.5 - inside).clamp(0., 1.);
+        let mix = |c: u8, b: u8| f32::from(c) * (1. - edge) + f32::from(b) * edge;
+        let rgb = [
+            mix(px[0], border[0]),
+            mix(px[1], border[1]),
+            mix(px[2], border[2]),
+        ];
+        let channel = |c: f32| (c * cover).round() as u32;
+        *out = ((cover * 255.).round() as u32) << 24
+            | channel(rgb[0]) << 16
+            | channel(rgb[1]) << 8
+            | channel(rgb[2]);
+    }
+}
