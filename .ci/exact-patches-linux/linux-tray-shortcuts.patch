+
+    /// Colours a host's shell gives some of Exact's roles where it tells
+    /// no whole palette (the Linux tray's window takes GNOME's popup
+    /// menu's): `(role, light, dark)`, RGBA. Reported for the process, and
+    /// the page painted again under them.
+    pub fn report_role_colors(&mut self, entries: &[(&str, [u8; 4], [u8; 4])]) {
+        let mut out = Vec::with_capacity(entries.len() * 2);
+        for (name, light, dark) in entries {
+            let Some(id) = roles::role(name) else {
+                debug_assert!(false, "{name} is no colour role");
+                continue;
+            };
+            for (scheme, rgba) in [(false, light), (true, dark)] {
+                out.push((
+                    ColorValue::Role(id),
+                    scheme,
+                    Color(u32::from_be_bytes(*rgba)),
+                ));
+            }
+        }
+        roles::set_reported(out);
+        self.host.colors_changed(true);
+        self.brush.colors_changed();
+        self.dirty = true;
+    }
 }
 
