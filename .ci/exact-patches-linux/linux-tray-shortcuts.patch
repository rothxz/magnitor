 }
 
+/// The desktop's interface font's family (GNOME's `font-name`, a Pango
+/// description such as "Ubuntu Sans 11"), read once through the settings
+/// portal; `None` without one.
+pub(crate) fn interface_font(address: &str) -> Option<String> {
+    let mut bus = Bus::connect(address, Duration::from_millis(500)).ok()?;
+    let args = [Value::str(GNOME), Value::str("font-name")];
+    let reply = match bus.call(PORTAL, PORTAL_PATH, INTERFACE, "ReadOne", &args) {
+        Err(error) if error.starts_with("org.freedesktop.DBus.Error.UnknownMethod") => {
+            bus.call(PORTAL, PORTAL_PATH, INTERFACE, "Read", &args)
+        }
+        other => other,
+    }
+    .ok()?;
+    let mut value = reply.first()?;
+    while let Value::Variant(inner) = value {
+        value = inner;
+    }
+    match value {
+        Value::Str(description) => font_family(description),
+        _ => None,
+    }
+}
+
+/// A Pango font description's family: without its size and its style words.
+fn font_family(description: &str) -> Option<String> {
+    const STYLES: [&str; 14] = [
+        "Thin",
+        "Light",
+        "Regular",
+        "Book",
+        "Medium",
+        "Semi-Bold",
+        "SemiBold",
+        "Bold",
+        "Heavy",
+        "Italic",
+        "Oblique",
+        "Condensed",
+        "Expanded",
+        "Normal",
+    ];
+    let mut words: Vec<&str> = description
+        .trim()
+        .trim_end_matches(',')
+        .split_whitespace()
+        .collect();
+    if words
+        .last()
+        .is_some_and(|w| w.trim_end_matches("px").parse::<f32>().is_ok())
+    {
+        words.pop();
+    }
+    while words.len() > 1 && words.last().is_some_and(|w| STYLES.contains(w)) {
+        words.pop();
+    }
+    let family = words.join(" ");
+    (!family.is_empty()).then_some(family)
+}
+
 pub(crate) fn watch_settings<T: Copy + Default + PartialEq + Send + 'static>(
     address: &str,
     select: fn(WindowSettings) -> T,
@@ -127,3 +186,22 @@ pub(crate) fn watch_settings<T: Copy + Default + PartialEq + Send + 'static>(
     let initial = receive.recv_timeout(STARTUP).unwrap_or_default();
     Some(SettingsWatch { initial, socket })
 }
+
+#[cfg(test)]
+mod tests {
+    use super::font_family;
+
+    #[test]
+    fn a_pango_description_names_its_family() {
+        assert_eq!(
+            font_family("Ubuntu Sans 11").as_deref(),
+            Some("Ubuntu Sans")
+        );
+        assert_eq!(
+            font_family("Cantarell Bold 11").as_deref(),
+            Some("Cantarell")
+        );
+        assert_eq!(font_family("Noto Sans").as_deref(), Some("Noto Sans"));
+        assert_eq!(font_family("  "), None);
+    }
+}
diff --git a/host/painted/src/portal/bus/shortcuts.rs b/host/painted/src/portal/bus/shortcuts.rs
new file mode 100644
index 000000000..50942b4b7
--- /dev/null
+++ b/host/painted/src/portal/bus/shortcuts.rs
@@ -0,0 +1,242 @@
+//! Global shortcuts through the desktop portal
+//! ([`org.freedesktop.portal.GlobalShortcuts`](https://flatpak.github.io/xdg-desktop-portal/docs/doc-org.freedesktop.portal.GlobalShortcuts.html)):
+//! a session of the app's chords, bound once, whose `Activated` signals are
+//! the presses.
+//!
+//! - A session binds once: the portal refuses a second `BindShortcuts` on
+//!   it, so another set of chords is another session, on a connection of
+//!   its own. Dropping [`Bound`] closes that connection, and the portal
+//!   ends the session with it.
+//! - The desktop keeps the trigger it first bound for a shortcut's id, and
+//!   ignores a later `preferred_trigger` for that id; the caller names each
+//!   shortcut by its chord, so a new chord is a new shortcut.
+//! - The first binding may ask the person (GNOME's dialog), so the thread
+//!   waits on each answer without limit.
+
+use super::{Bus, Value, PORTAL, PORTAL_PATH};
+use std::os::unix::net::UnixStream;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::Duration;
+
+const INTERFACE: &str = "org.freedesktop.portal.GlobalShortcuts";
+
+/// One shortcut to bind: the portal's id for it, what the desktop's
+/// settings call it, and the chord in the shortcuts specification's words
+/// (see [`trigger`]).
+pub struct Shortcut {
+    /// The portal's id for it, which an `Activated` signal names.
+    pub id: String,
+    /// What the desktop's settings call it.
+    pub description: String,
+    /// The chord asked for (`CTRL+ALT+LOGO+s`).
+    pub trigger: String,
+}
+
+/// A bound session, held while it lives.
+pub struct Bound {
+    socket: UnixStream,
+}
+
+impl Drop for Bound {
+    fn drop(&mut self) {
+        let _ = self.socket.shutdown(std::net::Shutdown::Both);
+    }
+}
+
+static TOKENS: AtomicU64 = AtomicU64::new(0);
+
+fn token() -> String {
+    format!(
+        "exact{}_{}",
+        std::process::id(),
+        TOKENS.fetch_add(1, Ordering::Relaxed)
+    )
+}
+
+/// Bind `shortcuts` in a session of their own on the bus at `address`.
+/// `pressed` is called, from the session's thread, with a shortcut's id
+/// at each press; `failed`, once, with why the session ended or bound
+/// nothing.
+pub fn bind(
+    address: &str,
+    shortcuts: Vec<Shortcut>,
+    pressed: impl Fn(&str) + Send + 'static,
+    failed: impl Fn(String) + Send + 'static,
+) -> Result<Bound, String> {
+    let mut bus = Bus::connect(address, Duration::from_secs(5))?;
+    let socket = bus.stream.try_clone().map_err(|e| e.to_string())?;
+    std::thread::Builder::new()
+        .name("exact-global-shortcuts".into())
+        .spawn(move || {
+            if let Err(error) = serve(&mut bus, &shortcuts, &pressed) {
+                failed(error);
+            }
+        })
+        .map_err(|e| e.to_string())?;
+    Ok(Bound { socket })
+}
+
+/// Ask the portal for `member` as a request (`org.freedesktop.portal.Request`)
+/// and wait for its `Response`: its results, or why there were none.
+fn request(
+    bus: &mut Bus,
+    member: &str,
+    token: &str,
+    body: &[Value],
+) -> Result<Value, String> {
+    let expected = crate::portal::request_path(&bus.unique, token);
+    let response = |path: &str| {
+        format!("type='signal',sender='{PORTAL}',interface='org.freedesktop.portal.Request',member='Response',path='{path}'")
+    };
+    bus.subscribe(&response(&expected))?;
+    let reply = bus.call(PORTAL, PORTAL_PATH, INTERFACE, member, body)?;
+    let handle = match reply.as_slice() {
+        [Value::Path(handle)] => handle.clone(),
+        _ => return Err(format!("the portal's {member} gave no request")),
+    };
+    if handle != expected {
+        bus.subscribe(&response(&handle))?;
+    }
+    loop {
+        let m = bus.signal()?;
+        if m.member != "Response" || m.path != handle {
+            continue;
+        }
+        return match m.body.as_slice() {
+            [Value::U32(0), results] => Ok(results.clone()),
+            [Value::U32(1), _] => Err(format!("{member} was cancelled")),
+            _ => Err(format!("the portal refused {member}")),
+        };
+    }
+}
+
+fn serve(bus: &mut Bus, shortcuts: &[Shortcut], pressed: &dyn Fn(&str)) -> Result<(), String> {
+    bus.wait_forever();
+    bus.subscribe(&format!(
+        "type='signal',sender='{PORTAL}',interface='{INTERFACE}',member='Activated'"
+    ))?;
+    let (ask, name) = (token(), token());
+    let options = Value::dict(vec![
+        ("handle_token", Value::str(&ask)),
+        ("session_handle_token", Value::str(&name)),
+    ]);
+    let created = request(bus, "CreateSession", &ask, &[options])?;
+    let session = match created.get("session_handle") {
+        Some(Value::Str(path) | Value::Path(path)) => path.clone(),
+        _ => return Err("the portal made no session".into()),
+    };
+    let list = shortcuts
+        .iter()
+        .map(|s| {
+            Value::Struct(vec![
+                Value::str(&s.id),
+                Value::dict(vec![
+                    ("description", Value::str(&s.description)),
+                    ("preferred_trigger", Value::str(&s.trigger)),
+                ]),
+            ])
+        })
+        .collect();
+    let ask = token();
+    request(
+        bus,
+        "BindShortcuts",
+        &ask,
+        &[
+            Value::Path(session.clone()),
+            Value::Array("(sa{sv})".into(), list),
+            Value::str(""),
+            Value::dict(vec![("handle_token", Value::str(&ask))]),
+        ],
+    )?;
+    loop {
+        let m = bus.signal()?;
+        if m.member != "Activated" {
+            continue;
+        }
+        if let [Value::Path(at) | Value::Str(at), Value::Str(id), ..] = m.body.as_slice() {
+            if *at == session {
+                pressed(id);
+            }
+        }
+    }
+}
+
+/// An `aria-keyshortcuts` chord (`Control+Alt+Meta+S`) in the shortcuts
+/// specification's words (`CTRL+ALT+LOGO+s`: its modifiers, then an XKB
+/// key name), or why it is none: `invalid`, or `not-allowed` for a pair of
+/// the same modifier.
+pub fn trigger(keys: &str) -> Result<String, &'static str> {
+    const MODIFIERS: [(&str, &str); 4] = [
+        ("Control", "CTRL"),
+        ("Alt", "ALT"),
+        ("Shift", "SHIFT"),
+        ("Meta", "LOGO"),
+    ];
+    let parts: Vec<&str> = keys.split('+').collect();
+    let (key, modifiers) = parts.split_last().ok_or("invalid")?;
+    if let [a, b] = parts[..] {
+        if a == b && MODIFIERS.iter().any(|(m, _)| *m == a) {
+            return Err("not-allowed");
+        }
+    }
+    let mut out = String::new();
+    for m in modifiers {
+        let (_, name) = MODIFIERS.iter().find(|(n, _)| n == m).ok_or("invalid")?;
+        out.push_str(name);
+        out.push('+');
+    }
+    out.push_str(&key_name(key).ok_or("invalid")?);
+    Ok(out)
+}
+
+/// A key's XKB name.
+fn key_name(key: &str) -> Option<String> {
+    let mut chars = key.chars();
+    if let (Some(c), None) = (chars.next(), chars.next()) {
+        return c
+            .is_ascii_alphanumeric()
+            .then(|| c.to_ascii_lowercase().to_string());
+    }
+    if let Some(n) = key.strip_prefix('F').and_then(|n| n.parse::<u32>().ok()) {
+        return (1..=24).contains(&n).then(|| format!("F{n}"));
+    }
+    Some(
+        match key {
+            "Space" | " " => "space",
+            "Enter" => "Return",
+            "Escape" => "Escape",
+            "Tab" => "Tab",
+            "Backspace" => "BackSpace",
+            "Delete" => "Delete",
+            "Insert" => "Insert",
+            "Home" => "Home",
+            "End" => "End",
+            "PageUp" => "Page_Up",
+            "PageDown" => "Page_Down",
+            "ArrowLeft" => "Left",
+            "ArrowUp" => "Up",
+            "ArrowRight" => "Right",
+            "ArrowDown" => "Down",
+            "PrintScreen" => "Print",
+            _ => return None,
+        }
+        .to_owned(),
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::trigger;
+
+    #[test]
+    fn a_chord_is_named_as_the_shortcuts_specification_names_it() {
+        assert_eq!(trigger("Control+Alt+Meta+S").as_deref(), Ok("CTRL+ALT+LOGO+s"));
+        assert_eq!(trigger("Alt+Meta+ArrowUp").as_deref(), Ok("ALT+LOGO+Up"));
+        assert_eq!(trigger("Shift+F12").as_deref(), Ok("SHIFT+F12"));
+        assert_eq!(trigger("PrintScreen").as_deref(), Ok("Print"));
+        assert_eq!(trigger("Meta+Meta"), Err("not-allowed"));
+        assert_eq!(trigger("Hyper+K"), Err("invalid"));
+        assert_eq!(trigger("Control+Shift"), Err("invalid"));
+    }
+}
diff --git a/host/painted/src/portal/bus/tray.rs b/host/painted/src/portal/bus/tray.rs
new file mode 100644
index 000000000..c5ab632e6
--- /dev/null
+++ b/host/painted/src/portal/bus/tray.rs
@@ -0,0 +1,466 @@
+//! A status item in the Linux desktop's tray: a `StatusNotifierItem` served
+//! on the session bus and registered with the desktop's
+//! `StatusNotifierWatcher` (KDE Plasma; GNOME with the AppIndicator
+//! extension, which Ubuntu enables), as the
+//! [StatusNotifierItem specification](https://www.freedesktop.org/wiki/Specifications/StatusNotifierItem/StatusNotifierItem/)
+//! describes it.
+//!
+//! - **The icon** is drawn by its host and handed over as pixels
+//!   (`IconPixmap`: ARGB32 in network byte order); the tooltip is the
+//!   item's label. A change is announced with `NewIcon` and `NewToolTip`,
+//!   and the tray reads the properties again.
+//! - **The clicks**: `Activate` (a primary click), `SecondaryActivate` (a
+//!   middle click) and `ContextMenu` (a right click; the item exports no
+//!   `com.canonical.dbusmenu` menu) reach the host as [`Heard`] on the
+//!   item's own thread.
+//! - **The watcher restarting** (the shell reloaded) names a new owner of
+//!   `org.kde.StatusNotifierWatcher`; the item registers again with it.
+//!
+//! One thread reads the connection and answers each call; the host's
+//! changes write signals from its own thread through the shared writer.
+
+use super::{Bus, DBUS, DBUS_PATH};
+use crate::portal::wire::{self, Message, Value};
+use std::io::Write;
+use std::os::unix::net::UnixStream;
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+const WATCHER: &str = "org.kde.StatusNotifierWatcher";
+const WATCHER_PATH: &str = "/StatusNotifierWatcher";
+const ITEM: &str = "org.kde.StatusNotifierItem";
+const ITEM_PATH: &str = "/StatusNotifierItem";
+const PROPERTIES: &str = "org.freedesktop.DBus.Properties";
+const INTROSPECTABLE: &str = "org.freedesktop.DBus.Introspectable";
+const PEER: &str = "org.freedesktop.DBus.Peer";
+
+/// What the tray said of the item. Coordinates are the screen's, as the
+/// tray gives them (often zero under Wayland).
+#[derive(Debug, Clone, PartialEq)]
+pub enum Heard {
+    /// A primary click.
+    Activate(i32, i32),
+    /// A middle click.
+    SecondaryActivate(i32, i32),
+    /// A right click, asking for the item's menu.
+    ContextMenu(i32, i32),
+    /// A scroll over the item: its delta and `"vertical"` or `"horizontal"`.
+    Scroll(i32, String),
+}
+
+/// One picture of the icon: `width` × `height` pixels, ARGB32 in network
+/// byte order ([`argb`]).
+#[derive(Debug, Clone, PartialEq)]
+pub struct Pixmap {
+    /// Pixels across.
+    pub width: i32,
+    /// Pixels down.
+    pub height: i32,
+    /// A, R, G, B bytes per pixel, row by row.
+    pub argb: Vec<u8>,
+}
+
+/// Premultiplied RGBA (a tiny-skia pixmap's data) as straight ARGB32 in
+/// network byte order, its alpha scaled by `opacity` (`1.0`: as drawn).
+pub fn argb(rgba: &[u8], opacity: f32) -> Vec<u8> {
+    let mut out = Vec::with_capacity(rgba.len());
+    for px in rgba.as_chunks::<4>().0 {
+        let a = u32::from(px[3]);
+        let straight = |c: u8| match a {
+            0 => 0,
+            _ => ((u32::from(c) * 255 + a / 2) / a).min(255) as u8,
+        };
+        let alpha = (a as f32 * opacity.clamp(0., 1.)).round() as u8;
+        out.extend([alpha, straight(px[0]), straight(px[1]), straight(px[2])]);
+    }
+    out
+}
+
+/// What the item shows, as its properties answer.
+struct Shown {
+    id: String,
+    title: String,
+    tooltip: String,
+    icons: Vec<Pixmap>,
+}
+
+/// The connection's writing half, and what the item shows.
+struct Shared {
+    out: UnixStream,
+    serial: u32,
+    shown: Shown,
+}
+
+impl Shared {
+    fn next(&mut self) -> u32 {
+        self.serial = self.serial.wrapping_add(1).max(1);
+        self.serial
+    }
+
+    fn send(&mut self, bytes: &[u8]) {
+        // A write that fails means the bus is gone; the reader ends too.
+        let _ = self.out.write_all(bytes);
+    }
+
+    fn signal(&mut self, member: &str) {
+        let serial = self.next();
+        let m = wire::message(wire::SIGNAL, serial, None, "", ITEM_PATH, ITEM, member, &[]);
+        self.send(&m);
+    }
+
+    fn register(&mut self, name: &str) {
+        let serial = self.next();
+        let m = wire::message(
+            wire::METHOD_CALL,
+            serial,
+            None,
+            WATCHER,
+            WATCHER_PATH,
+            WATCHER,
+            "RegisterStatusNotifierItem",
+            &[Value::str(name)],
+        );
+        self.send(&m);
+    }
+
+    fn reply(&mut self, to: &Message, body: &[Value]) {
+        let serial = self.next();
+        let m = wire::message(
+            wire::METHOD_RETURN,
+            serial,
+            Some(to.serial),
+            &to.sender,
+            "",
+            "",
+            "",
+            body,
+        );
+        self.send(&m);
+    }
+
+    fn refuse(&mut self, to: &Message, name: &str, text: &str) {
+        let serial = self.next();
+        let m = wire::error(serial, to.serial, &to.sender, name, text);
+        self.send(&m);
+    }
+}
+
+fn pixmaps(icons: &[Pixmap]) -> Value {
+    let icons = icons
+        .iter()
+        .map(|p| {
+            Value::Struct(vec![
+                Value::I32(p.width),
+                Value::I32(p.height),
+                Value::Array("y".into(), p.argb.iter().map(|b| Value::Byte(*b)).collect()),
+            ])
+        })
+        .collect();
+    Value::Array("(iiay)".into(), icons)
+}
+
+fn none() -> Value {
+    Value::Array("(iiay)".into(), Vec::new())
+}
+
+/// The item's properties, by name.
+fn property(shown: &Shown, name: &str) -> Option<Value> {
+    Some(match name {
+        "Category" => Value::str("ApplicationStatus"),
+        "Id" => Value::str(&shown.id),
+        "Title" => Value::str(&shown.title),
+        "Status" => Value::str("Active"),
+        "WindowId" => Value::I32(0),
+        "IconThemePath" | "IconName" | "OverlayIconName" | "AttentionIconName"
+        | "AttentionMovieName" => Value::str(""),
+        "IconPixmap" => pixmaps(&shown.icons),
+        "OverlayIconPixmap" | "AttentionIconPixmap" => none(),
+        "ToolTip" => Value::Struct(vec![
+            Value::str(""),
+            none(),
+            Value::str(&shown.tooltip),
+            Value::str(""),
+        ]),
+        "ItemIsMenu" => Value::Bool(false),
+        // No dbusmenu: the conventional path for an item without one.
+        "Menu" => Value::Path("/NO_DBUSMENU".into()),
+        _ => return None,
+    })
+}
+
+const NAMES: [&str; 16] = [
+    "Category",
+    "Id",
+    "Title",
+    "Status",
+    "WindowId",
+    "IconThemePath",
+    "IconName",
+    "IconPixmap",
+    "OverlayIconName",
+    "OverlayIconPixmap",
+    "AttentionIconName",
+    "AttentionIconPixmap",
+    "AttentionMovieName",
+    "ToolTip",
+    "ItemIsMenu",
+    "Menu",
+];
+
+const INTROSPECTION: &str = r#"<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
+<node>
+  <interface name="org.kde.StatusNotifierItem">
+    <property name="Category" type="s" access="read"/>
+    <property name="Id" type="s" access="read"/>
+    <property name="Title" type="s" access="read"/>
+    <property name="Status" type="s" access="read"/>
+    <property name="WindowId" type="i" access="read"/>
+    <property name="IconThemePath" type="s" access="read"/>
+    <property name="IconName" type="s" access="read"/>
+    <property name="IconPixmap" type="a(iiay)" access="read"/>
+    <property name="OverlayIconName" type="s" access="read"/>
+    <property name="OverlayIconPixmap" type="a(iiay)" access="read"/>
+    <property name="AttentionIconName" type="s" access="read"/>
+    <property name="AttentionIconPixmap" type="a(iiay)" access="read"/>
+    <property name="AttentionMovieName" type="s" access="read"/>
+    <property name="ToolTip" type="(sa(iiay)ss)" access="read"/>
+    <property name="ItemIsMenu" type="b" access="read"/>
+    <property name="Menu" type="o" access="read"/>
+    <method name="ContextMenu"><arg name="x" type="i" direction="in"/><arg name="y" type="i" direction="in"/></method>
+    <method name="Activate"><arg name="x" type="i" direction="in"/><arg name="y" type="i" direction="in"/></method>
+    <method name="SecondaryActivate"><arg name="x" type="i" direction="in"/><arg name="y" type="i" direction="in"/></method>
+    <method name="Scroll"><arg name="delta" type="i" direction="in"/><arg name="orientation" type="s" direction="in"/></method>
+    <signal name="NewTitle"/>
+    <signal name="NewIcon"/>
+    <signal name="NewAttentionIcon"/>
+    <signal name="NewOverlayIcon"/>
+    <signal name="NewToolTip"/>
+    <signal name="NewStatus"><arg name="status" type="s"/></signal>
+  </interface>
+  <interface name="org.freedesktop.DBus.Properties">
+    <method name="Get"><arg type="s" direction="in"/><arg type="s" direction="in"/><arg type="v" direction="out"/></method>
+    <method name="GetAll"><arg type="s" direction="in"/><arg type="a{sv}" direction="out"/></method>
+  </interface>
+  <interface name="org.freedesktop.DBus.Introspectable">
+    <method name="Introspect"><arg type="s" direction="out"/></method>
+  </interface>
+</node>"#;
+
+const ROOT_INTROSPECTION: &str = r#"<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
+<node><node name="StatusNotifierItem"/></node>"#;
+
+fn int(v: Option<&Value>) -> i32 {
+    match v {
+        Some(Value::Num(n)) => *n as i32,
+        Some(Value::I32(n)) => *n,
+        _ => 0,
+    }
+}
+
+/// A status item shown in the tray while this lives; dropping it takes the
+/// item away.
+pub struct StatusNotifier {
+    shared: Arc<Mutex<Shared>>,
+}
+
+impl StatusNotifier {
+    /// Serve an item named `id`, titled `title`, and register it with the
+    /// desktop's tray. `heard` runs on the item's thread for each click.
+    /// An error when there is no session bus or the desktop has no tray.
+    pub fn start(
+        id: &str,
+        title: &str,
+        heard: impl Fn(Heard) + Send + 'static,
+    ) -> Result<StatusNotifier, String> {
+        let address = std::env::var("DBUS_SESSION_BUS_ADDRESS")
+            .ok()
+            .filter(|a| !a.is_empty())
+            .ok_or("there is no session bus")?;
+        let mut bus = Bus::connect(&address, Duration::from_secs(5))?;
+        let owned = bus.call(
+            DBUS,
+            DBUS_PATH,
+            DBUS,
+            "NameHasOwner",
+            &[Value::str(WATCHER)],
+        )?;
+        if owned.first() != Some(&Value::Bool(true)) {
+            return Err("the desktop shows no tray (no StatusNotifierWatcher on the session bus; on GNOME, enable the AppIndicator extension)".into());
+        }
+        let name = format!("org.kde.StatusNotifierItem-{}-1", std::process::id());
+        // DBUS_NAME_FLAG_DO_NOT_QUEUE: this process owns it or none.
+        bus.call(
+            DBUS,
+            DBUS_PATH,
+            DBUS,
+            "RequestName",
+            &[Value::str(&name), Value::U32(4)],
+        )?;
+        bus.subscribe(&format!(
+            "type='signal',sender='{DBUS}',interface='{DBUS}',member='NameOwnerChanged',arg0='{WATCHER}'"
+        ))?;
+        bus.wait_forever();
+        let out = bus.stream.try_clone().map_err(|e| e.to_string())?;
+        let _ = out.set_write_timeout(Some(Duration::from_secs(5)));
+        let shared = Arc::new(Mutex::new(Shared {
+            out,
+            serial: bus.serial,
+            shown: Shown {
+                id: id.to_owned(),
+                title: title.to_owned(),
+                tooltip: title.to_owned(),
+                icons: Vec::new(),
+            },
+        }));
+        // Registered from the item's own thread, which answers the
+        // watcher's reads that follow at once.
+        shared.lock().map_err(|e| e.to_string())?.register(&name);
+        let serving = shared.clone();
+        std::thread::Builder::new()
+            .name("exact-tray".into())
+            .spawn(move || serve(bus, serving, name, heard))
+            .map_err(|e| e.to_string())?;
+        Ok(StatusNotifier { shared })
+    }
+
+    /// Show `icons` (one picture per size) in the tray.
+    pub fn set_icon(&self, icons: Vec<Pixmap>) {
+        if let Ok(mut shared) = self.shared.lock() {
+            if shared.shown.icons != icons {
+                shared.shown.icons = icons;
+                shared.signal("NewIcon");
+            }
+        }
+    }
+
+    /// The tooltip, the item's label.
+    pub fn set_tooltip(&self, text: &str) {
+        if let Ok(mut shared) = self.shared.lock() {
+            if shared.shown.tooltip != text {
+                shared.shown.tooltip = text.to_owned();
+                shared.signal("NewToolTip");
+            }
+        }
+    }
+}
+
+impl Drop for StatusNotifier {
+    fn drop(&mut self) {
+        // The reader's blocked read ends, and with the connection the
+        // bus releases the name, which the watcher hears.
+        if let Ok(shared) = self.shared.lock() {
+            let _ = shared.out.shutdown(std::net::Shutdown::Both);
+        }
+    }
+}
+
+fn serve(mut bus: Bus, shared: Arc<Mutex<Shared>>, name: String, heard: impl Fn(Heard)) {
+    while let Ok(m) = bus.message() {
+        let Ok(mut s) = shared.lock() else { return };
+        match m.kind {
+            wire::METHOD_CALL => {
+                if let Some(click) = answer(&mut s, &m) {
+                    drop(s);
+                    heard(click);
+                }
+            }
+            wire::SIGNAL if m.member == "NameOwnerChanged" => {
+                // The watcher came back: register with the new one.
+                if let [Value::Str(n), _, Value::Str(owner)] = m.body.as_slice() {
+                    if n == WATCHER && !owner.is_empty() {
+                        s.register(&name);
+                    }
+                }
+            }
+            wire::ERROR => {
+                eprintln!("exact: tray: {}", m.error_name);
+            }
+            _ => {}
+        }
+    }
+}
+
+/// Answer call `m`; the click it was, if one.
+fn answer(s: &mut Shared, m: &Message) -> Option<Heard> {
+    const UNKNOWN_METHOD: &str = "org.freedesktop.DBus.Error.UnknownMethod";
+    let str_at = |i: usize| match m.body.get(i) {
+        Some(Value::Str(s)) => s.as_str(),
+        _ => "",
+    };
+    match (m.path.as_str(), m.interface.as_str(), m.member.as_str()) {
+        (_, PEER, "Ping") => s.reply(m, &[]),
+        ("/", INTROSPECTABLE, "Introspect") => s.reply(m, &[Value::str(ROOT_INTROSPECTION)]),
+        (ITEM_PATH, INTROSPECTABLE, "Introspect") => s.reply(m, &[Value::str(INTROSPECTION)]),
+        (ITEM_PATH, PROPERTIES, "Get") => match property(&s.shown, str_at(1)) {
+            Some(v) => s.reply(m, &[Value::Variant(Box::new(v))]),
+            None => s.refuse(
+                m,
+                "org.freedesktop.DBus.Error.UnknownProperty",
+                "no such property",
+            ),
+        },
+        (ITEM_PATH, PROPERTIES, "GetAll") => {
+            let entries = NAMES
+                .iter()
+                .filter_map(|n| Some((*n, property(&s.shown, n)?)))
+                .collect();
+            s.reply(m, &[Value::dict(entries)]);
+        }
+        (ITEM_PATH, ITEM | "", member) => {
+            let at = (int(m.body.first()), int(m.body.get(1)));
+            let click = match member {
+                "Activate" => Heard::Activate(at.0, at.1),
+                "SecondaryActivate" => Heard::SecondaryActivate(at.0, at.1),
+                "ContextMenu" => Heard::ContextMenu(at.0, at.1),
+                "Scroll" => Heard::Scroll(at.0, str_at(1).to_owned()),
+                _ => {
+                    s.refuse(m, UNKNOWN_METHOD, "no such method");
+                    return None;
+                }
+            };
+            s.reply(m, &[]);
+            return Some(click);
+        }
+        _ => s.refuse(m, UNKNOWN_METHOD, "no such method"),
+    }
+    None
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn argb_unpremultiplies_into_network_order() {
+        // Half-transparent pure red, premultiplied.
+        assert_eq!(argb(&[128, 0, 0, 128], 1.), vec![128, 255, 0, 0]);
+        assert_eq!(argb(&[0, 0, 0, 0], 1.), vec![0, 0, 0, 0]);
+        assert_eq!(argb(&[255, 255, 255, 255], 0.5)[0], 128);
+    }
+
+    #[test]
+    fn get_all_answers_every_property_the_specification_names() {
+        let shown = Shown {
+            id: "com.example.app".into(),
+            title: "Example".into(),
+            tooltip: "Example".into(),
+            icons: vec![Pixmap {
+                width: 1,
+                height: 1,
+                argb: vec![255, 1, 2, 3],
+            }],
+        };
+        for name in NAMES {
+            assert!(property(&shown, name).is_some(), "{name}");
+        }
+        assert_eq!(
+            property(&shown, "IconPixmap").unwrap().signature(),
+            "a(iiay)"
+        );
+        assert_eq!(
+            property(&shown, "ToolTip").unwrap().signature(),
+            "(sa(iiay)ss)"
+        );
+        assert_eq!(property(&shown, "WindowId").unwrap().signature(), "i");
+    }
+}
