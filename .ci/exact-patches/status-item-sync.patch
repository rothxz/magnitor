+    /// What `image(of:)` shows, as a value equal while the picture is: that
+    /// makes a new NSImage at each call, so a caller that keeps an image (a
+    /// status item's button, synced after every batch) compares this instead.
+    /// A raster's bitmap is held, so its identity is never another's.
+    func imageKey(of row: NodeView) -> ImageKey? {
+        guard row.isButton else { return nil }
+        if let symbol = row.face?.symbol { return ImageKey(text: "face:\(symbol)", bitmap: nil) }
+        guard !row.isNativeButton, let img = Self.firstImage(in: row) else { return nil }
+        if let source = img.imageSource, source.hasPrefix("symbol:") {
+            return img.image.map { _ in ImageKey(text: "\(source)#\(img.symbolKey ?? "")", bitmap: nil) }
+        }
+        return img.raster.map { ImageKey(text: "raster", bitmap: $0.image.image) }
+    }
+    struct ImageKey {
+        let text: String
+        let bitmap: AnyObject?
+        static func same(_ a: ImageKey?, _ b: ImageKey?) -> Bool {
+            guard let a, let b else { return a == nil && b == nil }
+            return a.text == b.text && a.bitmap === b.bitmap
+        }
+    }
