// Run on macOS with a fixture home and scripted programs, so no real folder is measured,
// and Finder is not opened:
//   bun exact.mjs agent macos --test app.test.contract --home tools/home \
//     --process /bin/df=script:tools/df.json \
//     --process /usr/bin/mdfind=script:tools/mdfind.json --process /usr/bin/mdls=script:tools/mdls.json \
//     --process /usr/bin/open=script:tools/open.json
// The Rust source walks tools/home itself (the driver's `--home`). Its files are whole 4 KiB
// blocks, so each takes on disk what it holds:
//   Library/Caches: com.alpha/ 48 KiB, CocoaPods/ 24 KiB, loose.bin 8 KiB
//   Library/Developer/Xcode/DerivedData: Rycap-…/ 120 KiB, info.bin 40 KiB
//   Documents 320 KiB, Downloads 240 KiB, Desktop 4 KiB, Movies empty, no Pictures or Music
// tools/df.json reports a disk of 1e9 KiB with 5e8 KiB free; Spotlight's scripts name
// com.alpha "Alpha".
//   Projects/engine (Cargo.toml): target/ 96 KiB; Projects/web (package.json): node_modules/
//   64 KiB, .next/ 16 KiB; .npm/_cacache 32 KiB: with DerivedData and CocoaPods' cache, the six
//   Developer Files finds
// tools/home/.ports stands in for the listening servers (the Rust `ports` source reads it under
// the agent only): vite on 3000 in ~/Projects/web, Postgres on 5432, Django on 8000 open to the
// network, and ControlCenter's AirPlay on 7000. Stopping one there only takes it off the list.
// Under the agent the native module's Trash moves nothing (the fixtures stay), answering each
// path that exists as moved.
// tools/home/.vitals stands in for the machine's load (the Rust `vitals` source reads it under
// the agent only): CPU 97%, memory 62%, normal pressure.
// tools/home/go/pkg/mod is Go's module cache (4 KiB), which Developer Files offers to clear
// with `go clean -modcache` (never run under the agent); the walk never enters it.
// tools/volume is a folder outside home, with one project: shop's node_modules, 8 KiB.
// tools/home/.processes stands in for the process alerts' readings (the Rust `unusual` source,
// under the agent only): node at 180% CPU, and Leaky at 800 MB growing 150 MB a minute.
// A menu bar app shows no window: each test opens the stats popover from the status item
// first, as a person does, once the menu bar has laid the item out (a moment after launch,
// on real time): the popover points at it.

test "each folder's size and share of the total"
  clock +2000 real
  tap "status-item"
  clock settle
  tap "tab-storage"
  expect tree has "stats"
  expect text "total" == "823 KB"
  expect text "name-caches" == "App caches"
  expect text "size-caches" == "82 KB"
  expect text "percent-caches" == "10%"
  expect text "size-derived" == "164 KB"
  expect text "percent-derived" == "19.9%"
  expect text "size-documents" == "328 KB"
  expect text "percent-documents" == "39.8%"
  expect text "percent-downloads" == "29.9%"
  expect text "size-desktop" == "4 KB"
  expect text "percent-desktop" == "0.5%"
  expect tree missing "slice-movies"
  expect tree missing "slice-pictures"
  expect tree missing "slice-music"
  expect text "disk" == "These folders use <0.1% of your disk. 512 GB is free."
  expect tree missing "clear"
  expect text "quit" == "Quit Magnitor"

test "Measure Again asks the folders again"
  clock +2000 real
  tap "status-item"
  clock settle
  tap "tab-storage"
  tap "rescan"
  clock data
  expect state generation == 1
  expect text "total" == "823 KB"
  expect no failures

test "App caches opens each app's cache, by the app's name, largest first"
  clock +2000 real
  tap "status-item"
  clock settle
  tap "tab-storage"
  tap "slice-caches"
  clock data
  expect text "folder-name" == "App caches"
  expect text "folder-total" == "82 KB"
  expect text "item-name-0" == "Alpha"
  expect text "item-detail-0" == "com.alpha"
  expect text "item-size-0" == "49 KB"
  expect text "item-percent-0" == "60%"
  expect text "item-name-1" == "CocoaPods"
  expect tree missing "item-detail-1"
  expect text "item-size-1" == "25 KB"
  expect text "item-percent-1" == "30%"
  expect text "item-name-2" == "Other files"
  expect text "item-size-2" == "8 KB"
  expect text "item-percent-2" == "10%"
  tap "item-reveal-0"
  clock data
  expect no failures
  tap "back"
  expect text "total" == "823 KB"
  expect tree missing "folder-name"

test "Xcode build data opens each project's build folder"
  clock +2000 real
  tap "status-item"
  clock settle
  tap "tab-storage"
  tap "slice-derived"
  clock data
  expect text "folder-name" == "Xcode build data"
  expect text "folder-total" == "164 KB"
  expect text "item-name-0" == "Rycap"
  expect text "item-detail-0" == "Xcode project"
  expect text "item-size-0" == "123 KB"
  expect text "item-percent-0" == "75%"
  expect text "item-name-1" == "Other files"
  expect text "item-size-1" == "41 KB"
  expect text "item-percent-1" == "25%"

test "a folder on this Mac opens too"
  clock +2000 real
  tap "status-item"
  clock settle
  tap "tab-storage"
  tap "slice-desktop"
  clock data
  expect text "folder-name" == "Desktop"
  expect text "item-name-0" == "Other files"
  expect text "item-size-0" == "4 KB"
  expect text "item-percent-0" == "100%"

// Activity Monitor reads this Mac's real processes, so these tests name only what every Mac
// runs: Magnitor itself, Finder (this user's) and launchd (root's, pid 1). Nothing is quit:
// each Quit is cancelled.

test "Activity Monitor is the first tab, and the control switches to Storage and back"
  clock +2000 real
  tap "status-item"
  clock settle
  expect state tab == "tasks"
  clock data
  expect state tasks.count >= 10
  expect state tasks.error == ""
  expect tree has "cpu-graph"
  expect tree has "memory-used"
  expect tree has "proc-0"
  tap "tab-storage"
  expect state tab == "storage"
  expect text "total" == "823 KB"
  tap "tab-tasks"
  expect state tab == "tasks"

test "Activity Monitor reads again while it is open"
  clock +2000 real
  tap "status-item"
  clock settle
  tap "tab-tasks"
  clock data
  clock +3100 real
  clock data
  expect state tick >= 1
  expect state tasks.error == ""

test "Activity Monitor reads as often as Settings says, and keeps the choice"
  at "/settings"
  expect state refresh == 3
  type "refresh" "5"
  expect state refresh == 5
  reload
  expect state refresh == 5
  clock +2000 real
  tap "status-item"
  clock settle
  clock data
  clock +3100 real
  expect state tick == 0
  clock +2000 real
  expect state tick == 1

test "a search finds Magnitor itself, which quits only from Quit Magnitor"
  clock +2000 real
  tap "status-item"
  clock settle
  tap "tab-tasks"
  clock data
  type "search" "Magnitor"
  clock data
  expect text "proc-name-0" == "Magnitor"
  tap "proc-0"
  clock data
  expect text "info-name" == "Magnitor"
  expect text "end-why" == "This is Magnitor. To quit it, use Quit Magnitor."
  tap "proc-back"
  expect state inspected == -1
  expect tree has "search"

test "another user's process can be inspected, not quit"
  clock +2000 real
  tap "status-item"
  clock settle
  tap "tab-tasks"
  clock data
  type "search" "launchd"
  clock data
  expect text "proc-name-0" == "launchd"
  expect text "proc-detail-0" == "1 · root"
  tap "proc-0"
  clock data
  expect text "info-pid" == "1"
  expect text "info-user" == "root"
  expect text "end-why" == "launchd belongs to root. You can quit only your own processes."

test "Quit and Force Quit ask first, and Cancel ends nothing"
  clock +2000 real
  tap "status-item"
  clock settle
  tap "tab-tasks"
  clock data
  type "search" "Finder"
  clock data
  expect text "proc-name-0" == "Finder"
  tap "proc-0"
  clock data
  expect tree missing "end-why"
  tap "end-quit"
  expect text "end-confirm-text" == "Quit “Finder”?"
  tap "end-cancel"
  expect tree missing "end-confirm-text"
  tap "end-force"
  expect text "end-confirm-text" == "Force quit “Finder”? It ends at once, and anything unsaved in it is lost."
  tap "end-cancel"
  expect state ended == none
  expect state ending == ""

test "sorting and a search that matches nothing"
  clock +2000 real
  tap "status-item"
  clock settle
  tap "tab-tasks"
  clock data
  tap "sort-memory"
  clock data
  expect state sort == "memory"
  tap "sort-name"
  clock data
  expect state sort == "name"
  type "search" "no-such-process-here"
  clock data
  expect text "no-match" == "No process matches “no-such-process-here”."

// Quit in the menu ends the row at once, with no inspector. The processes here are real, so
// no test presses it on one that would end; Magnitor's own row has it disabled.
test "a right-click on a row opens its actions; Magnitor's own can't be quit there"
  clock +2000 real
  tap "status-item"
  clock settle
  tap "tab-tasks"
  clock data
  type "search" "Magnitor"
  clock data
  expect text "proc-name-0" == "Magnitor"
  tap "proc-0" contextmenu
  expect state aimedName == "Magnitor"
  expect tree has "menu-open"
  expect disabled "menu-quit"
  expect disabled "menu-force"

test "another user's process has Quit in its menu disabled"
  clock +2000 real
  tap "status-item"
  clock settle
  tap "tab-tasks"
  clock data
  type "search" "launchd"
  clock data
  tap "proc-0" contextmenu
  expect disabled "menu-quit"
  expect disabled "menu-force"
  tap "menu-open"
  clock data
  expect text "info-pid" == "1"

test "↑ and ↓ move the highlight, Enter opens it, and ⌘K opens its actions"
  clock +2000 real
  tap "status-item"
  clock settle
  tap "tab-tasks"
  clock data
  expect state highlighted == -1
  type "search" key "ArrowDown"
  expect state highlighted == 0
  type "search" key "ArrowDown"
  expect state highlighted == 1
  type "search" key "ArrowUp"
  expect state highlighted == 0
  type "search" key "ArrowUp"
  expect state highlighted == 0
  type "search" key "Meta+k"
  expect state aimedPid >= 0
  expect tree has "menu-open"
  tap "menu-open"
  clock data
  expect state listKeys == false

test "a search highlights its top match, and Enter opens it"
  clock +2000 real
  tap "status-item"
  clock settle
  tap "tab-tasks"
  clock data
  type "search" "launchd"
  clock data
  expect state highlighted == 0
  type "search" key "Enter"
  clock data
  expect text "info-pid" == "1"

// Settings. The gear in the popover's footer (⌘,) opens the Mac's Settings window; these open
// Settings at its route in the main window (`at "/settings"`), where it is a screen over the
// app with Done. tools/home/.vitals is the machine under load: CPU 97%, memory 62%. The main
// window watches it every five seconds while the widget is kept up to date (the default).

test "the list groups each app's processes, and its heading shows every process instead"
  clock +2000 real
  tap "status-item"
  clock settle
  clock data
  expect state grouped == true
  expect tree has "proc-0"
  tap "group"
  clock data
  expect state grouped == false
  expect tree has "proc-0"
  tap "group"
  expect state grouped == true

test "a recorded shortcut is kept; a key without ⌘ or ⌃ is refused, and Clear forgets it"
  at "/settings"
  expect text "hotkey" == "Record Shortcut"
  expect text "hotkey-note" == "Choose keys that open Magnitor from any app."
  tap "hotkey"
  expect state recording == true
  expect text "hotkey-note" == "Press the keys together. Escape cancels."
  type "hotkey" key "s"
  expect text "hotkey-note" == "Use ⌘ or ⌃ with another key, such as ⌃⌥⌘S."
  expect state hotkey == ""
  type "hotkey" key "Control+Alt+Meta+s"
  clock data
  expect state hotkey == "Control+Alt+Meta+S"
  expect state recording == false
  expect text "hotkey" == "⌃⌥⌘S"
  expect text "hotkey-note" == "Press ⌃⌥⌘S in any app to open Magnitor."
  tap "hotkey-clear"
  expect state hotkey == ""
  expect text "hotkey" == "Record Shortcut"
  tap "hotkey"
  type "hotkey" key "Alt+Meta+ArrowUp"
  expect state hotkey == "Alt+Meta+ArrowUp"
  expect text "hotkey" == "⌥⌘↑"
  reload
  expect state hotkey == "Alt+Meta+ArrowUp"

test "Escape stops recording and keeps the shortcut"
  at "/settings"
  tap "hotkey"
  type "hotkey" key "Escape"
  expect state recording == false
  expect state hotkey == ""

test "the menu bar item shows the chosen icon, or the load in its place"
  at "/settings"
  expect state trayShow == "icon"
  expect state trayLabel == "Magnitor"
  tap "tray-icon-cpu"
  expect state trayIcon == "cpu"
  type "tray-show" "both"
  expect tree missing "tray-icon"
  clock +2000
  clock data
  clock +2000
  clock data
  expect state vitals.cpu == 97
  expect state trayLabel == "CPU 97% · MEM 62%"
  type "tray-show" "cpu"
  expect state trayLabel == "CPU 97%"
  reload
  expect state trayShow == "cpu"
  expect state trayIcon == "cpu"

test "CPU held over its limit for the chosen time posts one alert; memory under its limit posts none"
  at "/settings"
  prefer permission.notifications granted
  tap "alerts-on"
  expect state alertsOn == true
  type "sustain" "10"
  clock +5000
  clock data
  clock +5000
  clock data
  expect state cpuAlerted == false
  clock +5000
  clock data
  clock +5000
  clock data
  expect state cpuAlerted == true
  expect state memoryAlerted == false
  expect state diskAlerted == false
  clock +5000
  clock data
  expect state cpuAlerted == true

test "no alert while alerts are off"
  at "/settings"
  clock +30000
  clock data
  expect state alertsOn == false
  expect state cpuAlerted == false
  expect state procPulse == 0

test "a process busy for the chosen time, and one whose memory keeps growing, each alert once"
  at "/settings"
  prefer permission.notifications granted
  tap "alerts-on"
  type "proc-busy-for" "60"
  expect state procBusyFor == 60
  clock +10000
  clock data
  clock +30000
  clock data
  clock +5000
  expect state procAlerted == []
  clock +60000
  clock data
  clock +5000
  expect state procAlerted.0 == "cpu:node:1"
  expect state procAlerted.length == 1
  clock +60000
  clock data
  clock +60000
  clock data
  clock +60000
  clock data
  clock +60000
  clock data
  clock +60000
  clock data
  clock +60000
  clock data
  clock +60000
  clock data
  clock +60000
  clock data
  clock +60000
  clock data
  clock +5000
  expect state procAlerted.1 == "memory:Leaky:1"
  expect state procAlerted.length == 2
  clock +60000
  clock data
  clock +5000
  expect state procAlerted.1 == "memory:Leaky:1"
  expect state procAlerted.length == 2
  reload
  expect state procBusyFor == 60

test "Never for both process limits reads no process"
  at "/settings"
  tap "alerts-on"
  type "proc-cpu-limit" "0"
  type "proc-grow-limit" "0"
  expect tree has "proc-busy-for"
  clock +30000
  clock data
  expect state procWatch == false
  expect state procPulse == 0

test "the widget shows the last reading, as Settings previews it"
  at "/settings"
  expect text "widget-empty" == "Open Magnitor to see your Mac’s load here."
  clock +5000
  clock data
  clock +5000
  clock data
  expect text "widget-cpu" == "97%"
  expect text "widget-memory" == "62%"
  expect text "widget-disk" == "512 GB free"
  type "widget-shows" "disk"
  clock +5000
  clock data
  expect tree missing "widget-cpu"
  expect text "widget-disk" == "512 GB free"

// Updates: under the agent the updater answers with this build's version and reaches no
// network, so a test build (0.1.0, ad hoc) is up to date and offers no install.
test "Settings says the build is up to date, checks again on Check Now, and keeps Check Automatically"
  at "/settings"
  clock data
  expect text "update-status" == "Magnitor 0.1.0 is up to date."
  expect text "update-note" == "Magnitor checks GitHub for a new version at launch and every six hours."
  expect tree missing "update-install"
  expect tree missing "update-available"
  tap "update-auto"
  expect state autoUpdate == false
  expect text "update-note" == "Magnitor checks for a new version only when you ask."
  tap "update-check"
  clock data
  expect state updatePulse == 1
  expect text "update-status" == "Magnitor 0.1.0 is up to date."
  reload
  expect state autoUpdate == false

// Ports.

test "Ports lists development servers first, by port, and folds away the other ports"
  clock +2000 real
  tap "status-item"
  clock settle
  tap "tab-ports"
  clock data
  expect text "port-0-port" == "3000"
  expect text "port-0-name" == "vite"
  expect text "port-0-detail" == "web · node · 2 h 14 min"
  expect tree has "port-0-browse"
  expect tree has "port-0-stop"
  expect tree missing "port-0-exposed"
  expect text "port-1-port" == "5432"
  expect text "port-1-name" == "postgres"
  expect text "port-1-detail" == "3 days 2 h"
  expect tree missing "port-1-browse"
  expect text "port-2-name" == "manage.py runserver"
  expect text "port-2-detail" == "api · python3 · 1 min"
  expect text "port-2-exposed" == "Open to your network"
  expect text "others-count" == "1"
  expect tree missing "other-0"
  tap "others-toggle"
  expect text "other-0-name" == "ControlCenter"
  expect tree missing "other-0-stop"
  tap "port-0-browse"
  clock data
  expect no failures

test "a server's details, where Stop asks first and Cancel stops nothing"
  clock +2000 real
  tap "status-item"
  clock settle
  tap "tab-ports"
  clock data
  tap "port-0-open"
  expect text "port-title" == "vite"
  expect text "port-number" == "3000"
  expect text "port-url" == "localhost:3000"
  expect text "port-address" == "This Mac only"
  expect text "port-process" == "node (4242)"
  expect text "port-running" == "2 h 14 min"
  expect text "port-folder" == "~/Projects/web"
  expect text "port-command" == "node node_modules/.bin/vite --port 3000"
  expect tree missing "port-exposed-note"
  tap "port-copy-url"
  expect text "port-detail-notice" == "Copied the URL."
  tap "port-stop"
  expect text "port-confirm-text" == "Stop vite on port 3000?"
  tap "port-cancel"
  expect tree missing "port-confirm-text"
  expect text "port-title" == "vite"
  tap "port-force"
  expect text "port-confirm-text" == "Force stop vite on port 3000? It ends at once, and anything unsaved in it is lost."
  tap "port-confirm"
  clock data
  expect state portPid == -1
  expect text "port-notice" == "Force stopped vite on port 3000."
  clock data
  expect text "port-0-name" == "postgres"

test "a server open to the network says so, and a row's Stop ends it at once"
  clock +2000 real
  tap "status-item"
  clock settle
  tap "tab-ports"
  clock data
  tap "port-2-open"
  expect text "port-address" == "All interfaces"
  expect tree has "port-exposed-note"
  tap "port-back"
  expect state portPid == -1
  tap "port-2-stop"
  clock data
  expect text "port-notice" == "Stopped manage.py runserver on port 8000."
  clock data
  expect tree missing "port-2"
  expect text "port-1-name" == "postgres"

// Developer Files. A project's suggestion depends on when its files last changed, which is when
// the fixture was checked out, so these tests choose by hand.

test "Storage leads to Developer Files: project folders and caches, largest first"
  clock +2000 real
  tap "status-item"
  clock settle
  tap "tab-storage"
  clock data
  expect text "dev-summary" == "401 KB in 6 items you can clean up"
  tap "dev-card"
  expect state cleaning == true
  expect text "clean-total" == "401 KB"
  expect text "dev-project-0-name" == "engine"
  expect text "dev-project-0-size" == "98 KB"
  expect text "dev-project-0-place" == "Rust build · ~/Projects/engine"
  expect text "dev-project-1-name" == "web"
  expect text "dev-project-1-size" == "66 KB"
  expect text "dev-project-1-place" == "Node modules · ~/Projects/web"
  expect text "dev-project-2-place" == "Next.js build · ~/Projects/web"
  expect text "dev-cache-0-name" == "Xcode build data"
  expect text "dev-cache-0-size" == "164 KB"
  expect text "dev-cache-0-place" == "Rebuilt the next time you build"
  expect text "dev-cache-1-name" == "npm cache"
  expect text "dev-cache-1-size" == "33 KB"
  expect text "dev-cache-2-name" == "CocoaPods cache"
  expect text "dev-cache-2-size" == "25 KB"
  tap "dev-cache-1-reveal"
  clock data
  expect no failures
  tap "clean-back"
  expect state cleaning == false
  expect text "total" == "823 KB"

test "choosing what to clean up, and Move to Trash asks first"
  clock +2000 real
  tap "status-item"
  clock settle
  tap "tab-storage"
  clock data
  tap "dev-card"
  tap "clean-none"
  expect text "clean-chosen" == "0 bytes"
  expect text "clean-go-label" == "Choose What to Clean Up"
  tap "dev-cache-0-check"
  expect text "clean-chosen" == "164 KB"
  tap "dev-project-0-check"
  expect text "clean-chosen" == "262 KB"
  expect text "clean-count" == "chosen · 2 items"
  tap "dev-project-0-check"
  expect text "clean-chosen" == "164 KB"
  tap "dev-project-0-check"
  expect text "clean-go-label" == "Move 262 KB to the Trash"
  tap "clean-go"
  expect text "clean-confirm-text" == "Move 2 items (262 KB) to the Trash? Each is rebuilt or downloaded again when a project needs it. Delete them from the Trash to free the space."
  tap "clean-cancel"
  expect tree missing "clean-confirm-text"
  tap "clean-suggested"
  expect state flipped == []
  tap "clean-none"
  tap "dev-cache-0-check"
  tap "dev-project-0-check"
  tap "clean-go"
  tap "clean-confirm"
  clock data
  expect text "clean-notice" == "Moved 2 items to the Trash. Delete them from the Trash to free 262 KB."
  expect text "dev-project-0-name" == "web"
  expect text "dev-cache-0-name" == "npm cache"
  expect text "clean-total" == "139 KB"
  tap "clean-back"
  clock data
  expect text "dev-summary" == "139 KB in 4 items you can clean up"

test "↑ and ↓ move through Ports, Enter opens a server, and ⌘K opens its actions"
  clock +2000 real
  tap "status-item"
  clock settle
  tap "tab-ports"
  clock data
  expect state portAt == -1
  type "root" key "ArrowDown"
  expect state portSelected == "4242:3000"
  type "root" key "ArrowDown"
  type "root" key "ArrowDown"
  type "root" key "ArrowDown"
  expect state portAt == 2
  type "root" key "ArrowUp"
  expect state portAt == 1
  type "root" key "Enter"
  expect text "port-number" == "5432"
  tap "port-back"
  expect state portAt == 1
  type "root" key "Meta+k"
  expect state aimedServerPort == 5432
  expect tree has "port-menu-info"

test "Delete Now deletes for good only what Magnitor moved, and asks first"
  clock +2000 real
  tap "status-item"
  clock settle
  tap "tab-storage"
  clock data
  tap "dev-card"
  tap "clean-none"
  tap "dev-cache-0-check"
  tap "clean-go"
  tap "clean-confirm"
  clock data
  expect text "purge-label" == "Delete 164 KB from the Trash Now"
  tap "purge"
  expect text "purge-confirm-text" == "Delete the item Magnitor moved to the Trash for good, freeing 164 KB? They can’t be put back. Nothing else in the Trash is touched."
  tap "purge-cancel"
  expect tree missing "purge-confirm-text"
  tap "purge"
  tap "purge-confirm"
  clock data
  expect text "clean-notice" == "Deleted 1 item for good, freeing 164 KB."
  expect tree missing "purge"

test "Go's module cache can't go to the Trash, so Developer Files runs its command, asked first"
  clock +2000 real
  tap "status-item"
  clock settle
  tap "tab-storage"
  clock data
  tap "dev-card"
  clock data
  expect text "dev-cmd-go-name" == "Go module cache"
  expect text "dev-cmd-go-command" == "go clean -modcache"
  expect text "dev-cmd-go-size" == "4 KB"
  tap "dev-cmd-go-run"
  expect text "cmd-confirm-text" == "Run go clean -modcache? Downloaded again when a project builds. Its files are read-only, so it can’t go to the Trash."
  tap "cmd-cancel"
  expect tree missing "cmd-confirm-text"
  tap "dev-cmd-go-run"
  tap "cmd-confirm"
  clock data
  expect text "clean-notice" == "Cleared Go’s module cache, freeing about 4 KB."

test "Settings adds a folder to look in, whose projects Developer Files lists too"
  at "/settings"
  tap "scan-add-button"
  pick "scan-add" "tools/volume"
  clock data
  expect state scanFolders.length == 1
  expect tree has "scan-folder-0"
  tap "scan-folder-0-remove"
  expect state scanFolders == []
  tap "scan-add-button"
  pick "scan-add" "tools/volume"
  clock data
  expect state scanFolders.length == 1
  tap "settings-done"
  clock +2000 real
  tap "status-item"
  clock settle
  tap "tab-storage"
  clock data
  tap "dev-card"
  clock data
  expect text "dev-project-3-name" == "shop"
  expect text "dev-project-3-size" == "8 KB"

test "the monthly developer files reminder starts counting when alerts go on"
  at "/settings"
  expect state remindCheckedAt == 0
  prefer permission.notifications granted
  tap "alerts-on"
  clock +5000
  clock data
  expect state remindCheckedAt >= 1
  expect state reminderScan == false

test "sharing with an iPhone makes a code, serves, and a new code replaces it"
  at "/settings"
  expect state shareOn == false
  expect tree missing "share-code"
  tap "share-on"
  clock data
  expect state shareOn == true
  expect tree has "share-code"
  clock +25000 real
  clock data
  expect state shareError == ""
  expect state shareControl == false
  tap "share-control"
  clock data
  expect state shareControl == true
  expect state shareError == ""
  tap "share-control"
  clock data
  expect state shareControl == false
  tap "share-new-code"
  clock data
  tap "share-on"
  clock data
  expect tree missing "share-code"
