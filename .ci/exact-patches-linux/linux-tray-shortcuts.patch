diff --git a/host/linux/src/window/shortcuts.rs b/host/linux/src/window/shortcuts.rs
new file mode 100644
index 000000000..0dd0e8f2d
--- /dev/null
+++ b/host/linux/src/window/shortcuts.rs
@@ -0,0 +1,175 @@
+//! The desktop modules' host services on Linux (`exact_painted::desktop`):
+//! global shortcuts through the desktop portal
+//! (`exact_painted::global_shortcuts`); nothing else is built.
+//!
+//! - One binding per chord serves every reader of it, as on Windows; a
+//!   press raises each reader's event as an activation.
+//! - The chords read are bound together, in one portal session. When they
+//!   change, that session is closed and the new set bound in another: the
+//!   portal binds a session once.
+//! - A chord is the portal's id for its shortcut, so the desktop binds a
+//!   new chord as asked rather than keeping an earlier one's trigger.
+//! - The portal answers on a thread of its own; a press reaches the event
+//!   loop as a message, where [`Desktop::pressed`] raises it.
+//! - The portal says nothing of a chord another app holds: a chord that
+//!   parses is registered, and a session the portal refuses is logged.
+
+use exact_painted::desktop::{Login, Refusal, Services};
+use exact_painted::global_shortcuts::{self as portal, Bound, Shortcut};
+use std::cell::RefCell;
+use std::rc::Rc;
+use std::sync::Arc;
+
+struct Reader {
+    session: String,
+    id: String,
+    keys: String,
+    extension: &'static str,
+    event: &'static str,
+}
+
+/// The host's one table of global shortcuts.
+pub(super) struct Desktop {
+    name: String,
+    readers: RefCell<Vec<Reader>>,
+    /// The chords bound, and their session.
+    bound: RefCell<Option<(Vec<String>, Bound)>>,
+    /// Hands a pressed chord to the event loop.
+    send: Arc<dyn Fn(String) + Send + Sync>,
+}
+
+impl Desktop {
+    /// The services for every session from now on; `send` hands a pressed
+    /// chord to the loop, which calls [`Desktop::pressed`] with it.
+    pub(super) fn install(name: &str, send: impl Fn(String) + Send + Sync + 'static) -> Rc<Desktop> {
+        let desktop = Rc::new(Desktop {
+            name: name.to_owned(),
+            readers: RefCell::default(),
+            bound: RefCell::default(),
+            send: Arc::new(send),
+        });
+        exact_painted::desktop::install(desktop.clone());
+        desktop
+    }
+
+    /// `keys` was pressed: each reader of it hears it.
+    pub(super) fn pressed(&self, keys: &str) {
+        for r in self.readers.borrow().iter().filter(|r| r.keys == keys) {
+            let event = exact_painted::package::json!({ "id": r.id, "keys": r.keys });
+            let args = exact_painted::package::json!([r.id, event]).to_string();
+            exact_painted::desktop::activate(r.extension, r.event, args);
+        }
+    }
+
+    /// Bind the chords read now, unless they are bound already.
+    fn rebind(&self) {
+        let readers = self.readers.borrow();
+        let mut chords: Vec<String> = readers.iter().map(|r| r.keys.clone()).collect();
+        chords.sort();
+        chords.dedup();
+        if self.bound.borrow().as_ref().is_some_and(|(bound, _)| *bound == chords) {
+            return;
+        }
+        // The old session ends first, so its chords are free to bind again.
+        self.bound.borrow_mut().take();
+        if chords.is_empty() {
+            return;
+        }
+        let Some(address) = std::env::var("DBUS_SESSION_BUS_ADDRESS")
+            .ok()
+            .filter(|a| !a.is_empty())
+        else {
+            eprintln!("exact: global shortcuts: there is no session bus");
+            return;
+        };
+        let shortcuts = chords
+            .iter()
+            .filter_map(|keys| {
+                let mut ids: Vec<&str> = readers
+                    .iter()
+                    .filter(|r| r.keys == *keys)
+                    .map(|r| r.id.as_str())
+                    .collect();
+                ids.dedup();
+                Some(Shortcut {
+                    id: keys.clone(),
+                    description: format!("{}: {}", self.name, ids.join(", ")),
+                    trigger: portal::trigger(keys).ok()?,
+                })
+            })
+            .collect();
+        let send = self.send.clone();
+        match portal::bind(
+            &address,
+            shortcuts,
+            move |keys| send(keys.to_owned()),
+            |error| eprintln!("exact: global shortcuts: {error}"),
+        ) {
+            Ok(bound) => *self.bound.borrow_mut() = Some((chords, bound)),
+            Err(error) => eprintln!("exact: global shortcuts: the session bus: {error}"),
+        }
+    }
+}
+
+impl Services for Desktop {
+    fn register_hotkey(
+        &self,
+        session: &str,
+        id: &str,
+        keys: &str,
+        _repeat: bool,
+        extension: &'static str,
+        event: &'static str,
+    ) -> Result<(), Refusal> {
+        portal::trigger(keys)?;
+        {
+            let mut readers = self.readers.borrow_mut();
+            let same = |r: &Reader| r.session == session && r.id == id && r.keys == keys;
+            if !readers.iter().any(same) {
+                readers.push(Reader {
+                    session: session.to_owned(),
+                    id: id.to_owned(),
+                    keys: keys.to_owned(),
+                    extension,
+                    event,
+                });
+            }
+        }
+        self.rebind();
+        Ok(())
+    }
+
+    fn unregister_hotkey(&self, session: &str, id: &str, keys: &str) {
+        self.readers
+            .borrow_mut()
+            .retain(|r| !(r.session == session && r.id == id && r.keys == keys));
+        self.rebind();
+    }
+
+    fn check_hotkey(&self, keys: &str) -> Result<(), Refusal> {
+        portal::trigger(keys).map(drop)
+    }
+
+    fn attention(&self, _critical: bool, _count: Option<u32>) -> Result<(), String> {
+        Err("attention is not built on Linux".into())
+    }
+
+    fn login(&self) -> Login {
+        Login {
+            state: "unknown",
+            hidden: false,
+        }
+    }
+
+    fn set_login(&self, _register: Option<bool>) -> Result<Login, String> {
+        Err("the login item is not built on Linux".into())
+    }
+
+    fn open_login_settings(&self) -> Result<(), String> {
+        Err("the login item is not built on Linux".into())
+    }
+
+    fn login_launch(&self) -> Option<bool> {
+        None
+    }
+}
diff --git a/host/linux/src/window/tray.rs b/host/linux/src/window/tray.rs
new file mode 100644
index 000000000..36c103ddf
--- /dev/null
+++ b/host/linux/src/window/tray.rs
@@ -0,0 +1,143 @@
+//! The status item in the desktop's tray (LLP 1133.025 D4 on Linux): the
+//! first `-exact-menu="status"` button becomes a `StatusNotifierItem`
+//! (`exact_painted::status_notifier`), and leaves the page, as the Mac's
+//! `NSStatusItem` and Windows' notification icon do.
+//!
+//! - **The icon** is the button's image (`Presenter::status_icon`) drawn
+//!   for a dark panel (GNOME's and Ubuntu's top bar) at 22 and 44 pixels;
+//!   the tooltip is its label. A button with no image shows a plain dot.
+//! - **A click** runs the button's `press` when it has one. Otherwise the
+//!   window stands in for the button's `popovertarget` popover, as the
+//!   Mac's `NSPopover` hangs from its item: a click shows the window with
+//!   the popover open, and another hides both. Closing the window, or the
+//!   popover closing, hides it; the app runs on in the tray.
+//! - **No tray** (no session bus, or GNOME without the AppIndicator
+//!   extension): the button stays an ordinary button in the window.
+use super::Event;
+use exact_kernel::ViewId;
+use exact_painted::presenter::top::StatusItem;
+use exact_painted::presenter::Presenter;
+use exact_painted::status_notifier::{argb, Heard, Pixmap, StatusNotifier};
+use exact_runner::DataSource;
+
+/// The icon's sizes, pixels: the panel's 22-point icon at 1× and 2×.
+const SIDES: [u32; 2] = [22, 44];
+
+pub(super) struct Tray {
+    notifier: StatusNotifier,
+    /// The status button as the tree last stood.
+    pub item: Option<StatusItem>,
+    /// What the icon was drawn from: the tree's epoch and the images'.
+    drawn: Option<(u64, Vec<(ViewId, usize)>)>,
+}
+
+/// What a click on the item asks of the host.
+pub(super) enum Does {
+    /// Run the button's `press`.
+    Press(ViewId),
+    /// Show or hide the window with the button's popover.
+    Toggle(ViewId),
+    Nothing,
+}
+
+impl Tray {
+    /// The tray item for `p`'s status button, if it has one and the desktop
+    /// has a tray; each click is handed to `send`, from the item's thread.
+    pub fn start<D: DataSource>(
+        p: &mut Presenter<D>,
+        id: &str,
+        title: &str,
+        send: impl Fn(Event) + Send + Sync + 'static,
+    ) -> Option<Tray> {
+        let item = p.status_items().into_iter().next()?;
+        let notifier = StatusNotifier::start(id, title, move |heard| send(Event::Tray(heard)));
+        match notifier {
+            Ok(notifier) => {
+                p.place_status_items();
+                Some(Tray {
+                    notifier,
+                    item: Some(item),
+                    drawn: None,
+                })
+            }
+            Err(error) => {
+                eprintln!("exact: tray: {error}; the status item stays in the window");
+                None
+            }
+        }
+    }
+
+    /// The icon and tooltip as the tree now stands.
+    pub fn sync<D: DataSource>(&mut self, p: &mut Presenter<D>) {
+        let item = p.status_items().into_iter().next();
+        let images: Vec<_> = item
+            .iter()
+            .filter_map(|item| item.image.map(|id| (id, SIDES[1])))
+            .collect();
+        let revision = p.sync_status_images(&images);
+        let stamp = (p.host().kernel().epoch(), revision);
+        let changed = self.drawn.as_ref() != Some(&stamp);
+        self.item = item;
+        if !changed {
+            return;
+        }
+        self.drawn = Some(stamp);
+        let Some(item) = &self.item else { return };
+        let opacity = if item.disabled { 0.36 } else { 1. };
+        let mut icons = Vec::new();
+        for side in SIDES {
+            let scale = side as f32 / SIDES[0] as f32;
+            let drawn = item
+                .image
+                .and_then(|image| p.status_icon(image, side, scale, true));
+            let rgba = match drawn {
+                Some(Ok(pixmap)) => pixmap.data().to_vec(),
+                Some(Err(error)) => {
+                    eprintln!("exact: tray: the status item's image did not draw: {error}");
+                    dot(side)
+                }
+                // Still loading, or no image: a dot until it draws.
+                None => dot(side),
+            };
+            icons.push(Pixmap {
+                width: side as i32,
+                height: side as i32,
+                argb: argb(&rgba, opacity),
+            });
+        }
+        self.notifier.set_icon(icons);
+        self.notifier.set_tooltip(&item.label);
+    }
+
+    /// What `heard` asks for.
+    pub fn does(&self, heard: &Heard) -> Does {
+        let Some(item) = self.item.as_ref().filter(|item| !item.disabled) else {
+            return Does::Nothing;
+        };
+        match heard {
+            Heard::Activate(..) | Heard::SecondaryActivate(..) | Heard::ContextMenu(..) => {
+                if item.press {
+                    Does::Press(item.node)
+                } else {
+                    Does::Toggle(item.node)
+                }
+            }
+            Heard::Scroll(..) => Does::Nothing,
+        }
+    }
+}
+
+/// A white dot, premultiplied RGBA, `side` pixels square.
+fn dot(side: u32) -> Vec<u8> {
+    let r = side as f32 * 0.3;
+    let c = side as f32 / 2.;
+    let mut out = Vec::with_capacity((side * side * 4) as usize);
+    for y in 0..side {
+        for x in 0..side {
+            let d = ((x as f32 + 0.5 - c).powi(2) + (y as f32 + 0.5 - c).powi(2)).sqrt();
+            let a = ((r - d + 0.5).clamp(0., 1.) * 255.).round() as u8;
+            out.extend([a, a, a, a]);
+        }
+    }
+    out
+}
