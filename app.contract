// Magnitor: the view. Three tabs under a segmented control: Activity (processes, CPU and
// memory, after the Mac's own Activity Monitor), Storage, and Ports (the servers listening on
// this Mac, for a developer: what holds port 3000, opened in the browser or stopped). Storage
// leads to Developer Files: the project folders (`node_modules`, `target`) and the tools' caches
// a developer can clear, moved to the Trash. The Rust crate in data/ measures the folders and lists what is
// in each, walking them on many threads, reads the processes, CPU and memory, the ports, and
// finds the developer files; app.ts answers the disk's size, the apps' names, Show in Finder,
// opening a page and the Trash. On macOS the app lives in the menu bar (app.json's
// `accessory`) and shows no window: the status item opens the `stats` popover,
// AppKit's NSPopover pointing at the item, with the system's material (Liquid
// Glass on macOS 26 and later). A folder's row opens its contents in the popover.
//
// The gear in the popover's footer (and ⌘,) opens Settings, the Mac's Settings window: a
// keyboard shortcut that opens the popover from any app, what the menu bar item shows, the
// desktop widget (app.json's `widgets`, drawn by `VitalsWidget` from the reading `saveWidget`
// keeps) and alerts, a notification when the CPU, memory or free disk space crosses a limit, or
// one process stays busy or its memory keeps growing (`unusual`, the Rust crate's).
// Settings are `persist` states, which the two windows share; the main window alone watches
// the machine (`vitals`, the Rust crate's) and holds the shortcut.
use globalShortcut, checkGlobalShortcut, globalshortcut, GlobalShortcut, GlobalShortcutCheck, GlobalShortcutEvent from "@exact/global-shortcuts"
use showNotification, notificationStatus, requestNotificationPermission, notificationclick, NotificationStatus, NotificationEvent from "@exact/notifications"

routes nav
  home "/"
    settings "/settings"

shape Slice
  id: string
  name: string
  group: string
  bytes: number
  size: string
  percent: string
  path: string
  labelX: number
  labelY: number
  labelled: bool

shape Usage
  total: string
  totalBytes: number
  slices: Slice[]
  cacheBytes: number
  cacheSize: string
  error: string

shape Disk
  size: number
  free: string
  freeBytes: number

shape AppName
  id: string
  name: string

shape Item
  path: string
  name: string
  detail: string
  folder: string
  bytes: number
  size: string
  percent: string

shape Contents
  id: string
  total: string
  items: Item[]
  error: string

shape Revealed
  ok: bool

shape Proc
  pid: number
  name: string
  detail: string
  cpu: string
  memory: string
  mine: bool
  // The app bundle it runs in ("" for a process outside an app), whose icon `ProcIcon` asks
  // for once. The icons themselves stay out of this reading: as data URLs they were nearly all
  // of each tick’s answer, sent and compared again every few seconds.
  app: string
  // An app's processes as one row (grouped): `pid` is its main process's, `name` the app's,
  // `count` how many, and `cpu` and `memory` theirs added up. One process: false and 1.
  group: bool
  count: number

// An app's icon as a PNG data URL ("" when none could be drawn).
shape AppIcon
  icon: string

shape Tasks
  cpuUser: string
  cpuSystem: string
  cpuIdle: string
  userPath: string
  systemPath: string
  memoryUsed: string
  memoryTotal: string
  memoryShare: number
  pressure: string
  // How hard macOS is cooling the Mac (ProcessInfo's thermal state, not a temperature):
  // "Normal", "Fair", "Serious" or "Critical"; "" when it can't be read.
  thermal: string
  // The CPU dies' average temperature, "47 °C"; "" on a Mac without die sensors.
  temperature: string
  cached: string
  // Memory the compressor holds: the first sign of pressure, before swap.
  compressed: string
  swap: string
  count: number
  processes: Proc[]
  more: number
  // While searching: how many processes match, and their % CPU and memory added up, every
  // match counted (an app's main process and its helpers), not only the rows shown. "" with
  // no search.
  matchCount: number
  matchCpu: string
  matchMemory: string
  error: string

// One process, as Activity Monitor's inspector shows it.
shape ProcInfo
  pid: number
  found: bool
  name: string
  path: string
  user: string
  parent: string
  cpu: string
  cpuTime: string
  threads: string
  memory: string
  realMemory: string
  running: string
  mine: bool
  own: bool

shape Ended
  ok: bool
  message: string

// One app's processes together, as its grouped row's inspector shows them.
shape AppInfo
  // The app bundle's path, as the row named it.
  app: string
  found: bool
  name: string
  cpu: string
  memory: string
  count: number
  // The main process: the one whose parent is outside the app.
  main: number
  // Every process this user's, so they can be quit.
  mine: bool
  // Magnitor's own app, which quits only from Quit Magnitor.
  own: bool
  // Each process, busiest first.
  processes: Proc[]

// A port a process of this user's listens on (data/src/ports.rs): one row of Ports.
shape Server
  pid: number
  port: number
  // What a person started: "vite", "next dev", "manage.py runserver", or an app's name.
  name: string
  // The executable: "node".
  process: string
  // The command it was started with, the home folder as "~".
  command: string
  // Its working directory, "~/Projects/web" ("" for none), and that folder's own name.
  folder: string
  project: string
  // Reachable from other machines: it listens on every address, not this Mac's alone.
  exposed: bool
  // "http://localhost:3000"; "" for a server a browser can't open (a database).
  url: string
  running: string
  // A developer's server; else an app's, macOS's or a tool's own bridge on a port the system
  // chose, listed under Other Ports.
  dev: bool
  // The executable's path, and the working directory's in full, for Show in Finder.
  path: string
  dir: string
  // For a container's port (Docker, OrbStack): its id, which Stop stops, and its image; "" else.
  container: string
  image: string

shape Ports
  servers: Server[]
  error: string

// A folder Developer Files can move to the Trash (data/src/devclean.rs).
shape DevItem
  // From the home folder: "Projects/web/node_modules".
  path: string
  // The project's name, or the cache's.
  name: string
  // "Node modules", "Rust build"; "Cache" for a tool's cache.
  kind: string
  // A project's folder, "~/Projects/web"; what clearing a cache means.
  place: string
  // "Changed 3 months ago" ("" for a cache).
  age: string
  // "project" or "cache".
  group: string
  bytes: number
  size: string
  // Chosen at first: a rebuilt cache, or a project untouched for a month and not in use.
  suggested: bool
  // Why to think twice: "In use by node".
  note: string

shape DevFiles
  items: DevItem[]
  total: string
  totalBytes: number
  count: number
  // Project folders past the list's end, counted in the total.
  more: number
  error: string

// Space only its tool can free (data/src/devtools.rs): Go's module cache, a Docker prune,
// unavailable simulators; run when the person confirms, or copied when Magnitor can't run it.
shape DevCommand
  // "go", "docker" or "simulators".
  id: string
  name: string
  detail: string
  // What it stands for: "go clean -modcache".
  command: string
  bytes: number
  size: string
  available: bool
  // Why it can't run here ("Docker isn't running…"); "" when it can.
  note: string

shape DevCommands
  commands: DevCommand[]
  error: string

// A folder Settings' picker chose, as its path on disk ("" when it couldn't be read).
shape FolderPath
  path: string

shape Trashed
  ok: bool
  // The paths moved, as the view named them.
  moved: string[]
  message: string

// The machine's load alone, read every few seconds while something shows or watches it.
shape Vitals
  // Busy share of every core, 0 to 100.
  cpu: number
  // Share of memory used, 0 to 100.
  memory: number
  pressure: string
  memoryUsed: string
  error: string

// A process behaving unusually (data/src/watchdog.rs): busy over its limit for a while, or a
// footprint that keeps growing. Its id is the same for that kind and name until a cooldown
// passes, so the watch posts each one once.
shape UnusualProc
  id: string
  // "cpu" or "memory".
  kind: string
  pid: number
  name: string
  title: string
  body: string

shape Unusual
  findings: UnusualProc[]
  error: string

// Which window this session draws: "main", or "settings" for the Settings window; and the
// host: "macos", "linux", "web" …
shape Page
  name: string
  platform: string

shape Saved
  ok: bool

// One entry of the widget's timeline, as its refresh (app.ts's `widgetVitals`) answers it.
shape WidgetEntry
  date: number
  props: VitalsWidgetProps

shape Clock
  epochAtZero: number

// The latest release on GitHub, as modules/apple/Updater.swift reads it.
shape UpdateInfo
  current: string
  latest: string
  available: bool
  notes: string
  page: string
  download: string
  canInstall: bool
  error: string

shape UpdateInstall
  ok: bool
  message: string

// The desktop widget's reading (app.json's `widgets`).
shape VitalsWidgetProps
  // "all", "system" (CPU and memory) or "disk".
  shows: string
  cpu: number
  memory: number
  pressure: string
  free: string
  freeShare: number
  updated: string
  ready: bool

fn sliceColor(id: string): string = id == "caches" ? "-exact-system-orange" : id == "derived" ? "-exact-system-red" : id == "documents" ? "-exact-system-blue" : id == "downloads" ? "-exact-system-teal" : id == "desktop" ? "-exact-system-indigo" : id == "pictures" ? "-exact-system-green" : id == "movies" ? "-exact-system-purple" : "-exact-system-yellow"

// A share as Finder words it: 9.3%, <0.1%.
fn percentText(share: number): string = share > 0 and share < 0.001 ? "<0.1%" : `${round(share * 1000) / 10}%`

// An item by the name of the app that keeps it, when `names` (one per item, in order, from
// app.ts) has one for its folder; the folder's own name otherwise. A lookup by position: a
// search of every app for every item would pass the view's list-step limit on a full cache.
fn shownName(names: AppName[], i: number, it: Item): string = match names.at(i) { case some(a) => a.id == it.folder and a.name != "" ? a.name : it.name, case none => it.name }
// Under an app's name, its folder (the bundle id).
fn shownDetail(names: AppName[], i: number, it: Item): string = match names.at(i) { case some(a) => a.id == it.folder and a.name != "" ? it.folder : it.detail, case none => it.detail }

fn groupTitle(group: string): string = group == "cache" ? "Cache" : "On this Mac"

// Finder's decimal units, as data/src/lib.rs's `format_bytes` writes them: 511 KB, 8.2 GB.
fn oneDecimal(n: number): string = `${round(n * 10) / 10}`
fn sizeText(b: number): string = b < 1000 ? `${b} ${b == 1 ? "byte" : "bytes"}` : b < 1000000 ? `${round(b / 1000)} KB` : b < 1000000000 ? `${oneDecimal(b / 1000000)} MB` : b < 1000000000000 ? `${oneDecimal(b / 1000000000)} GB` : `${oneDecimal(b / 1000000000000)} TB`
fn itemsText(n: number): string = `${n} ${n == 1 ? "item" : "items"}`
// Whether a developer file is chosen: its suggestion, unless the person flipped it.
fn chosenNow(i: DevItem, flipped: string[]): bool = i.suggested != flipped.includes(i.path)
fn devLabel(i: DevItem): string = i.group == "project" ? `${i.name}, ${i.kind}, ${i.size}` : `${i.name}, ${i.size}`
fn devPlace(i: DevItem): string = i.group == "project" ? `${i.kind} · ${i.place}` : i.place
fn purgeText(n: number, bytes: number): string = `Delete ${n == 1 ? "the item" : `the ${itemsText(n)}`} Magnitor moved to the Trash for good, freeing ${sizeText(bytes)}? They can’t be put back. Nothing else in the Trash is touched.`
fn cmdText(c: DevCommand): string = `Run ${c.command}? ${c.detail}`
fn cleanText(n: number, bytes: number): string = `Move ${itemsText(n)} (${sizeText(bytes)}) to the Trash? Each is rebuilt or downloaded again when a project needs it. Delete them from the Trash to free the space.`

// A server's second line: its project, its executable when the name isn't it, how long it has run.
fn portDetail(s: Server): string = [s.project, s.image != "" ? s.image : (s.process != s.name ? s.process : ""), s.running].filter(x => x != "").join(" · ")
// A server's place in the list, for the keyboard's highlight.
fn portKey(s: Server): string = `${s.pid}:${s.port}`
fn portLabel(s: Server): string = `Port ${s.port}, ${s.name}${s.project != "" ? `, ${s.project}` : ""}${s.exposed ? ", open to your network" : ""}`
fn portEndText(how: string, s: Server): string = s.container != "" ? (how == "force" ? `Kill the container ${s.name}? It ends at once, without the chance to finish.` : `Stop the container ${s.name}? Docker gives it ten seconds to finish.`) : how == "force" ? `Force stop ${s.name} on port ${s.port}? It ends at once, and anything unsaved in it is lost.` : `Stop ${s.name} on port ${s.port}?`

fn sortLabel(key: string): string = key == "cpu" ? "CPU" : key == "memory" ? "Memory" : "Name"

// Activity Monitor's memory pressure colours.
fn pressureColor(p: string): string = p == "Critical" ? "-exact-system-red" : p == "Warning" ? "-exact-system-yellow" : "-exact-system-green"
// The thermal state's colours, as the memory pressure's run from green to red.
fn thermalColor(t: string): string = t == "Critical" ? "-exact-system-red" : t == "Serious" ? "-exact-system-orange" : t == "Fair" ? "-exact-system-yellow" : "-exact-system-green"

// A chord as the Mac's menus write it: Control+Alt+Meta+S is ⌃⌥⌘S.
fn keyGlyph(k: string): string = k == "Control" ? "⌃" : k == "Alt" ? "⌥" : k == "Shift" ? "⇧" : k == "Meta" ? "⌘" : k == "ArrowUp" ? "↑" : k == "ArrowDown" ? "↓" : k == "ArrowLeft" ? "←" : k == "ArrowRight" ? "→" : k == "Enter" ? "↩" : k == "Backspace" ? "⌫" : k == "Delete" ? "⌦" : k == "Tab" ? "⇥" : k == "Space" ? "Space" : k
fn chordText(keys: string): string = keys.split("+").map(k => keyGlyph(k)).join("")
// A press's key as a chord names it: the physical key for a letter or digit, so the chord is
// the same under any keyboard layout.
fn chordKey(e: KeyboardEvent): string = e.code.startsWith("Key") ? e.code.slice(3) : e.code.startsWith("Digit") ? e.code.slice(5) : e.key == " " ? "Space" : e.key.length == 1 ? e.key.toUpperCase() : e.key
fn chordOf(e: KeyboardEvent): string = [e.ctrlKey ? "Control" : "", e.altKey ? "Alt" : "", e.shiftKey ? "Shift" : "", e.metaKey ? "Meta" : "", chordKey(e)].filter(p => p != "").join("+")
fn isModifier(k: string): bool = k == "Meta" or k == "Control" or k == "Alt" or k == "Shift" or k == "CapsLock" or k == "Fn"
fn checkProblem(c: GlobalShortcutCheck): string = c.registered ? "" : match c.reason { case some(r) => r == "in-use" ? `Another app uses ${chordText(c.keys)}. Choose another shortcut.` : r == "reserved" ? `macOS keeps ${chordText(c.keys)} for itself. Choose another shortcut.` : `Magnitor can’t use ${chordText(c.keys)}. Choose another shortcut.`, case none => `Magnitor can’t use ${chordText(c.keys)}. Choose another shortcut.` }

// The menu bar item's symbol for each icon style.
fn trayIconSymbol(icon: string): string = icon == "gauge" ? "symbol:sf/gauge.with.dots.needle.33percent" : icon == "cpu" ? "symbol:sf/cpu" : icon == "memory" ? "symbol:sf/memorychip" : icon == "disk" ? "symbol:sf/internaldrive" : icon == "chart" ? "symbol:sf/chart.pie" : "symbol:sf/waveform.path.ecg"
fn trayIconName(icon: string): string = icon == "gauge" ? "Gauge" : icon == "cpu" ? "Chip" : icon == "memory" ? "Memory" : icon == "disk" ? "Disk" : icon == "chart" ? "Pie Chart" : "Waveform"
// The menu bar item's title when it shows the load instead of an icon: "–" before a reading.
fn trayTitle(show: string, v: Vitals): string = v.pressure == "" ? (show == "cpu" ? "CPU –" : "CPU – · MEM –") : show == "cpu" ? `CPU ${round(v.cpu)}%` : `CPU ${round(v.cpu)}% · MEM ${round(v.memory)}%`

fn number(v: string): number = match parseNumber(v) { case some(n) => n, case none => 0 }
fn limitText(n: number): string = n == 0 ? "Never" : `${n}%`
fn diskLimitText(gb: number): string = gb == 0 ? "Never" : `${gb} GB`
fn sustainText(s: number): string = s < 60 ? `${s} ${s == 1 ? "second" : "seconds"}` : `${s / 60} ${s == 60 ? "minute" : "minutes"}`

fn processes(n: number): string = `${n} ${n == 1 ? "process" : "processes"}`
// The pid of the row at `i`; -1 past the end.
fn pidAt(ps: Proc[], i: number): number = match ps.at(i) { case some(p) => p.pid, case none => -1 }
fn rowLabel(p: Proc): string =p.group ? `${p.name}, ${p.detail}, ${p.cpu} percent CPU, ${p.memory}` : `${p.name}, process ${p.pid}, ${p.cpu} percent CPU, ${p.memory}`
// What an app's action asks before it ends anything, and the button that confirms it.
fn appEndText(how: string, name: string, n: number): string = how == "force" ? `Force quit “${name}”? It ends at once, and anything unsaved in it is lost.` : how == "quitAll" ? `Quit all ${processes(n)} of “${name}”?` : how == "forceAll" ? `Force quit all ${processes(n)} of “${name}”? They end at once, and anything unsaved is lost.` : how == "restart" ? `Quit “${name}” and open it again?` : how == "forceRestart" ? `Force quit all of “${name}” and open it again? Anything unsaved is lost.` : `Quit “${name}”?`
fn appEndLabel(how: string): string = how == "force" ? "Force Quit" : how == "quitAll" ? "Quit All" : how == "forceAll" ? "Force Quit All" : how == "restart" ? "Restart" : how == "forceRestart" ? "Force Restart" : "Quit"
fn countText(n: number, more: number): string = more > 0 ? `${processes(n)} · ${more} more match: search to find one` : processes(n)

// The segmented controls in Liquid Glass (NSGlassEffectView on macOS 26 and later): a glass
// capsule, and on it a brighter glass pill under the chosen segment. They keep their tab and
// radio roles, so the arrow keys and VoiceOver work as on AppKit's own control.
style GlassTrack
  backgroundMaterial = "glass"
  border-radius = 999
  padding = 3
  gap = 2
  align-items = "center"

style Segment
  backgroundMaterial = "none"
  -exact-glass-tint = "transparent"
  border-radius = 999
  padding-top = 4
  padding-bottom = 4
  padding-left = 12
  padding-right = 12

style SegmentOn
  backgroundMaterial = "glass"
  -exact-glass-tint = "light-dark(rgba(255,255,255,0.55), rgba(255,255,255,0.16))"
  border-radius = 999
  padding-top = 4
  padding-bottom = 4
  padding-left = 12
  padding-right = 12

style Action
  flex = 1
  padding-top = 7
  padding-bottom = 7
  border-radius = 8
  background-color = "light-dark(rgba(0,0,0,0.08), rgba(255,255,255,0.12))"
  align-items = "center"
  justify-content = "center"

// A small choice beside the amount Developer Files has chosen.
style Chip
  padding-top = 4
  padding-bottom = 4
  padding-left = 12
  padding-right = 12
  border-radius = 999
  background-color = "light-dark(rgba(0,0,0,0.08), rgba(255,255,255,0.12))"

style Label
  color = "-exact-secondary-label"
  font-weight = 500

style LabelOn
  color = "-exact-label"
  font-weight = 600

component Magnitor
  // The tab the popover shows: "tasks" (Activity, the first), "storage" or "ports".
  state tab = "tasks"
  // Whether the popover is open: Activity Monitor reads the machine only while it is seen.
  state shown = false
  state generation = 0
  // The folder whose contents the popover shows; "" for the overview.
  state opened = ""
  // The Settings window draws Settings alone, so the folders are measured in the main one, and
  // only once Storage has been opened: a walk keeps every core busy for seconds, too much to
  // spend at each launch for a tab that may never be looked at.
  state storageSeen = false
  resource usage = usage(generation) when isMain and storageSeen as shape Usage else empty()
  resource contents = contents(opened, generation) when opened != "" as shape Contents else empty()
  // Asked again after each measure and each minute the main window watches (`diskPulse`).
  resource disk = disk(generation, diskPulse) when isMain as shape Disk else empty()
  // Asked with no folders at launch, which loads Spotlight's list ahead of App caches.
  resource names = appNamesFor(cacheFolders) when isMain as shape AppName[] else empty()
  mutation revealed as shape Revealed
  // Developer Files: found and measured with the folders, once Storage has been opened, and
  // afresh with each measure. A person's choice is kept as the paths they flipped from the
  // suggestion, so a new list needs nothing set up; what went to the Trash leaves the list at
  // once (`gone`), before the measure that follows confirms it.
  state cleaning = false
  state flipped: string[] = []
  state gone: string[] = []
  state cleanConfirm = false
  state cleanNotice = ""
  // Settings' folders to walk beyond home, and to leave out: absolute paths.
  state scanFolders: string[] = [] persist
  state scanSkip: string[] = [] persist
  mutation pickedAdd as shape FolderPath then afterPickAdd
  mutation pickedSkip as shape FolderPath then afterPickSkip
  resource dev = devFiles(generation, scanFolders, scanSkip) when isMain and (storageSeen or reminderScan) as shape DevFiles else empty()
  mutation trashed as shape Trashed then afterTrash
  // What Developer Files moved to the Trash this session, which Delete Now deletes for good.
  state trashedPaths: string[] = []
  state trashedBytes = 0
  state purgeConfirm = false
  mutation purged as shape Trashed then afterPurge
  // Space only a tool can free (Go's module cache, a Docker prune, old simulators), asked while
  // Developer Files is open; the one whose command waits to be confirmed.
  state toolsGeneration = 0
  state cmdAsk = ""
  resource devCmds = devCommands(toolsGeneration) when isMain and cleaning as shape DevCommands else empty()
  mutation cmdRan as shape Ended then afterCmd
  derive cmdAsked = devCmds.commands.filter(c => c.id == cmdAsk)
  // The monthly reminder: GB of suggested developer files that earn one (0 for never), when the
  // walk last looked (epoch ms; 0 until alerts first run), and a walk under way for it.
  state cleanRemind = 10 persist
  state remindCheckedAt = 0 persist
  state reminderScan = false
  derive suggestedBytes = sum(devItems.filter(i => i.suggested).map(i => i.bytes))
  derive devItems = dev.items.filter(i => not gone.includes(i.path))
  derive devProjects = devItems.filter(i => i.group == "project")
  derive devCaches = devItems.filter(i => i.group == "cache")
  derive chosen = devItems.filter(i => chosenNow(i, flipped))
  derive chosenBytes = sum(chosen.map(i => i.bytes))
  derive finding = not current(dev)
  // What was found, less what went to the Trash since.
  derive devTotalText = sizeText(dev.totalBytes - sum(dev.items.filter(i => gone.includes(i.path)).map(i => i.bytes)))
  derive devCount = devItems.length + dev.more
  derive devCardText = dev.error != "" ? dev.error : finding and devItems.length == 0 ? "Looking for build folders and caches…" : devCount == 0 ? "No build folders or caches take space." : `${devTotalText} in ${itemsText(devCount)} you can clean up`
  // Ports: read each tick while the tab shows, as Activity is. The server whose details show
  // (by pid and port; -1 for the list), and the one a right-click opened the menu for.
  state portPid = -1
  state portNumber = -1
  state portEnding = ""
  state portNotice = ""
  state othersShown = false
  state aimedServerPid = -1
  state aimedServerPort = -1
  resource ports = ports(tick) when isMain and tab == "ports" as shape Ports else empty() transient
  mutation portStopped as shape Ended then afterPortStop
  derive devServers = ports.servers.filter(s => s.dev)
  derive otherServers = ports.servers.filter(s => not s.dev)
  // Zero or one: the server whose details show, and the one the menu is for.
  derive openedServer = ports.servers.filter(s => s.pid == portPid and s.port == portNumber)
  derive aimedServer = ports.servers.filter(s => s.pid == aimedServerPid and s.port == aimedServerPort)
  derive portsReading = not current(ports) and ports.servers.length == 0 and ports.error == ""
  // The list's keys, as Activity's: the rows shown, in order, and the highlighted one.
  state portSelected = ""
  derive portRows = devServers.concat(othersShown ? otherServers : [])
  derive portAt = portRows.map(s => portKey(s)).indexOf(portSelected)
  derive portKeys = shown and tab == "ports" and portPid == -1 and top(nav).name == "home"
  // Activity Monitor: a reading each tick, sorted and searched in Rust.
  state tick = 0
  state sort = "cpu"
  state query = ""
  // The process the inspector shows; -1 for the list (0 is the kernel).
  state inspected = -1
  // Each app's processes as one row (Raycast's App Grouping), kept across launches.
  state grouped = true persist
  // The app whose processes the inspector shows (its bundle's path); "" for none.
  state inspectedApp = ""
  // What an app's action waits to be confirmed for: "quit", "force", "restart", "quitAll",
  // "forceAll" or "forceRestart"; "" for none.
  state appEnding = ""
  resource appInfo = appGroup(inspectedApp, tick) when tab == "tasks" and inspectedApp != "" as shape AppInfo else empty()
  mutation appEnded as shape Ended then afterAppEnd
  // "quit" or "force" while Quit or Force Quit waits to be confirmed.
  state ending = ""
  state endNotice = ""
  // The row ↑ and ↓ highlight, as Raycast's list does, by pid: the rows re-sort each tick, so
  // a position would slide to another process. -1 for none.
  state selected = -1
  // The row a right-click or ⌘K opened the actions menu for.
  state aimedPid = -1
  state aimedApp = ""
  state aimedName = ""
  state aimedGroup = false
  state aimedMine = false
  // `transient`: a reading is stale by the next tick, so it is never kept in the device's
  // storage for a later launch (which would write it out every few seconds).
  resource tasks = tasks(tick, sort, query, grouped) when isMain and tab == "tasks" as shape Tasks else empty() transient
  resource info = process(inspected, tick) when tab == "tasks" and inspected != -1 as shape ProcInfo else empty()
  // Each row's app icon, asked once per app (`key`): a tick that reorders the rows or keeps
  // an app's processes asks nothing, and an app that joins the list asks for its own alone.
  resource procIcons = appIcon(p.app) for p in tasks.processes key=p.app as shape AppIcon
  mutation ended as shape Ended then afterEnd
  // Every `refresh` seconds (Settings, three unless chosen): each reading lists every process
  // and redraws the list. A timer's interval is a literal, so each choice has its own; three
  // also stands for a kept value that is no longer offered.
  derive sampling = (tab == "tasks" or tab == "ports") and shown
  task sampler1 when sampling and refresh == 1
    every(1000, sample)
  task sampler2 when sampling and refresh == 2
    every(2000, sample)
  task sampler3 when sampling and not [1, 2, 5].includes(refresh)
    every(3000, sample)
  task sampler5 when sampling and refresh == 5
    every(5000, sample)

  resource page = exactPage() as shape Page
  // The date now is the clock's epoch at zero plus performanceNow().
  resource clock = exactTime() as shape Clock
  derive isMain = page.name == "main"
  // Linux's tray window is the popover: it opens and closes with it, and goes when it loses
  // the focus, so the popover there is manual, not light-dismissed. Settings, with no window
  // of its own there, is the page's screen under it: the popover stays open, so the window
  // stays, but is hidden meanwhile, and a click in Settings, outside it, leaves it open.
  derive tray = page.platform == "linux"
  derive settingsBelow = tray and top(nav).name == "settings"

  // Settings, kept across launches and shared by the windows.
  // The keyboard shortcut that opens the popover from any app, as `aria-keyshortcuts` names it.
  state hotkey = "" persist
  // What the menu bar item shows: "icon", "cpu" or "both" (CPU and memory).
  state trayShow = "icon" persist
  state trayIcon = "waveform" persist
  state widgetOn = true persist
  // What the widget shows: "all", "system" (CPU and memory) or "disk".
  state widgetShows = "all" persist
  state alertsOn = false persist
  // The limits, 0 for never: CPU and memory in percent, free disk space in GB.
  state cpuLimit = 90 persist
  state memoryLimit = 90 persist
  state diskLimit = 10 persist
  // How long, in seconds, CPU or memory stays over its limit before an alert.
  state sustain = 60 persist
  // One process's limits, 0 for never: % CPU (of one core, as Activity Monitor counts it), held
  // for `procBusyFor` seconds; and GB its memory grows by in ten minutes.
  state procCpuLimit = 100 persist
  state procBusyFor = 300 persist
  state procGrowLimit = 1 persist
  // Whether the main window checks GitHub for a new version, at launch and every six hours.
  state autoUpdate = true persist
  // How often, in seconds, Activity Monitor reads the machine while it is open: 1, 2, 3 or 5,
  // Activity Monitor's own choices and Magnitor's three. Each reading costs a little CPU, so a
  // longer one spends less. Not longer than five: `tasks.rs` takes a reading over ten seconds
  // old as no base for a rate, and would wait a second for a fresh one each time.
  state refresh = 3 persist

  // Updates: asked afresh each launch (the clock's epoch differs) and at each pulse. The
  // Settings window asks when it opens, and on Check Now.
  state updatePulse = 0
  state updating = false
  state updateNote = ""
  resource update = checkUpdate(updatePulse) with clock.epochAtZero when (isMain and autoUpdate) or inWindow or top(nav).name == "settings" or updatePulse > 0 as shape UpdateInfo else empty()
  mutation updateInstalled as shape UpdateInstall then afterInstall
  task updateTimer when isMain and autoUpdate
    every(21600000, recheckUpdate)
  derive updateStatus = not current(update) ? "Checking for updates…" : update.error != "" ? update.error : update.available ? `Magnitor ${update.latest} is available. You have ${update.current}.` : update.current != "" ? `Magnitor ${update.current} is up to date.` : ""
  derive updateFooter = updateNote != "" ? updateNote : update.available and not update.canInstall ? "This copy can’t update itself. Download the new version from Magnitor’s GitHub releases." : autoUpdate ? "Magnitor checks GitHub for a new version at launch and every six hours." : "Magnitor checks for a new version only when you ask."

  // Recording a shortcut in Settings, and why a press made none.
  state recording = false
  state hotkeyNote = ""
  mutation hotkeyChecked as shape GlobalShortcutCheck
  derive hotkeyProblem = match hotkeyChecked { case some(c) => c.keys == hotkey ? checkProblem(c) : "", case none => "" }
  // Held by the main window alone: a press goes to the session that reads the chord.
  resource shortcut = globalShortcut(id="open", keys=hotkey) when isMain and hotkey != "" as shape GlobalShortcut else empty(id="open", keys="", registered=false)
  resource notifying = notificationStatus() as shape NotificationStatus else empty(available=false, state="unknown", badge=false)
  mutation permission as shape NotificationStatus

  // The watch: a reading each pulse, for the menu bar, the alerts and the widget.
  state pulse = 0
  state diskPulse = 0
  state diskAt = 0
  // When CPU or memory went over its limit (performanceNow), 0 while under it.
  state cpuSince = 0
  state cpuAlerted = false
  state memorySince = 0
  state memoryAlerted = false
  state diskAlerted = false
  state widgetAt = 0
  state widgetShown = ""
  // The process alerts' reading, every ten seconds while they are on: it reads each of this
  // user's processes, more than `vitals` does, so it runs no oftener. The ids already posted,
  // the newest last.
  state procPulse = 0
  state procAt = 0
  state procAlerted: string[] = []
  derive procWatch = alertsOn and (procCpuLimit > 0 or procGrowLimit > 0)
  derive watching = isMain and (trayShow != "icon" or alertsOn or widgetOn)
  resource unusual = unusual(procPulse, procAt, procCpuLimit, procBusyFor, procGrowLimit) when watching and procWatch as shape Unusual else empty() transient
  derive procNext = unusual.findings.filter(f => not procAlerted.includes(f.id))
  // Every two seconds while the menu bar shows the load; five otherwise (Activity Monitor reads
  // its own load each tick, so an open popover needs no quicker watch).
  derive quick = trayShow != "icon"
  resource vitals = vitals(pulse) when watching as shape Vitals else empty()
  mutation widgetSaved as shape Saved refreshes widgetNow
  // What the widget shows now, previewed in Settings: its own refresh, which reads the last
  // reading the main window wrote.
  resource widgetNow = widgetVitals(0) when top(nav).name == "settings" as shape WidgetEntry[] else empty()
  derive widgetPreview = match widgetNow.at(0) { case some(w) => w.props, case none => VitalsWidgetProps(shows="all", cpu=0, memory=0, pressure="", free="", freeShare=0, updated="", ready=false) }
  task watcher when watching and quick
    every(2000, watch)
  task idleWatcher when watching and not quick
    every(5000, watch)
  derive inWindow = page.name == "settings"
  // The menu bar item's title and tooltip; with the load shown it is all AppKit draws.
  derive trayLabel = trayShow == "icon" ? "Magnitor" : trayTitle(trayShow, vitals)
  derive alertsNote = not alertsOn ? "Magnitor checks your Mac every few seconds while it runs, and tells you when it crosses a limit." : notifying.state == "denied" ? "Notifications for Magnitor are off. Turn them on in System Settings › Notifications › Magnitor." : `Magnitor tells you when CPU or memory stays over its limit for ${sustainText(sustain)}, or when free disk space drops below its limit.${procWatch ? " It also tells you when one of your apps or processes stays busy, or its memory keeps growing for ten minutes." : ""}${cleanRemind > 0 ? ` Once a month, it reminds you when developer files you can clean up pass ${cleanRemind} GB.` : ""}`
  derive hotkeyFooter = hotkeyNote != "" ? hotkeyNote : recording ? "Press the keys together. Escape cancels." : hotkeyProblem != "" ? hotkeyProblem : hotkey == "" ? "Choose keys that open Magnitor from any app." : `Press ${chordText(hotkey)} in any app to open Magnitor.`
  derive groups = ["cache", "device"].filter(g => usage.slices.filter(s => s.group == g).length > 0)
  derive measuring = not current(usage)
  derive openedName = usage.slices.filter(s => s.id == opened).map(s => s.name).join("")
  // The list of the folder that is open, never one left from the folder before.
  derive items = contents.id == opened ? contents.items : []
  derive cacheFolders = opened == "caches" ? items.map(it => it.folder) : []
  derive diskText = disk.size > 0 and usage.total != "" ? `These folders use ${percentText(usage.totalBytes / disk.size)} of your disk. ${disk.free} is free.` : ""
  derive listing = opened != "" and (not current(contents) or contents.id != opened)
  derive reading = tasks.count == 0 and tasks.error == ""
  // Shown from the first reading of this process on; a tick's re-reading keeps it on screen.
  derive infoReady = info.pid == inspected
  derive appReady = appInfo.app == inspectedApp
  derive appLocked = not appInfo.mine or appInfo.own or pending(appEnded)
  // The highlighted row's position: the selected process wherever it sorts now, else the top
  // match while searching (Enter opens it), else none.
  derive selectedAt = tasks.processes.map(p => p.pid).indexOf(selected)
  derive highlighted = selectedAt != -1 ? selectedAt : (query.trim() != "" and tasks.processes.length > 0 ? 0 : -1)
  // The list's keys work while it is what the popover shows.
  derive listKeys = shown and tab == "tasks" and inspected == -1 and inspectedApp == "" and top(nav).name == "home"

  state openStats = false
  task statsOpener when openStats
    after(500, showStats)

  // The popover first: AppKit's popover is a window of its own, and while it stays open the
  // app's last window has not closed, so the quit would wait for a click that dismisses it.
  action quit
    hidePopover("stats")
    close()
  action follow(url: string)
    nav = go(nav, url)
  action closeSettings
    nav = back(nav)
  // The shortcut, from any app: the popover, as a click on the menu bar item opens it.
  action hotkeyPressed(id: string, e: GlobalShortcutEvent)
    togglePopover("stats", source="status-item")
  // An alert's click opens the popover at what it is about (a process's, at that process), once
  // the status item is in the menu bar (`statsOpener`).
  action notified(tag: string, e: NotificationEvent)
    storageSeen = storageSeen or tag == "disk" or tag == "dev"
    tab = (tag == "disk" or tag == "dev") ? "storage" : "tasks"
    if tag == "dev"
      cleaning = true
    if tag.startsWith("process-")
      match e.data
        case some(pid)
          inspected = number(pid)
          inspectedApp = ""
          ending = ""
          endNotice = ""
        case none
          inspected = inspected
    openStats = true
  // The popover a click asked for, a moment later: at a launch from the click the menu bar has
  // not placed the status item yet, and a popover shown from it then is painted in the page.
  action showStats
    openStats = false
    showPopover("stats", source="status-item")
  action record
    recording = true
    hotkeyNote = ""
    focus("hotkey")
  action stopRecording
    recording = false
  action recordKey(k: string, e: KeyboardEvent)
    if recording
      preventDefault()
      if k == "Escape" and not (e.metaKey or e.ctrlKey or e.altKey or e.shiftKey)
        recording = false
      else if not isModifier(k)
        if e.metaKey or e.ctrlKey
          let chord = chordOf(e)
          hotkey = chord
          recording = false
          hotkeyNote = ""
          send hotkeyChecked = checkGlobalShortcut(keys=chord)
        else
          hotkeyNote = "Use ⌘ or ⌃ with another key, such as ⌃⌥⌘S."
  action clearHotkey
    hotkey = ""
    hotkeyNote = ""
    recording = false
  action setTrayShow(v: string)
    trayShow = v
  action setTrayIcon(icon: string)
    trayIcon = icon
  action setWidgetOn(on: bool)
    widgetOn = on
  action setWidgetShows(v: string)
    widgetShows = v
  action setAlertsOn(on: bool)
    alertsOn = on
    if on and notifying.state == "prompt"
      send permission = requestNotificationPermission()
  action setCpuLimit(v: string)
    cpuLimit = number(v)
  action setMemoryLimit(v: string)
    memoryLimit = number(v)
  action setDiskLimit(v: string)
    diskLimit = number(v)
  action setSustain(v: string)
    sustain = number(v)
  action setProcCpuLimit(v: string)
    procCpuLimit = number(v)
  action setProcBusyFor(v: string)
    procBusyFor = number(v)
  action setProcGrowLimit(v: string)
    procGrowLimit = number(v)
  action setRefresh(v: string)
    refresh = number(v)
  action setAutoUpdate(on: bool)
    autoUpdate = on
  action recheckUpdate
    updatePulse = updatePulse + 1
    updateNote = ""
  action installUpdate
    updating = true
    updateNote = ""
    send updateInstalled = installUpdate(update.download, update.latest)
  action afterInstall
    match updateInstalled
      case some(r)
        updateNote = r.message
        updating = r.ok
      case none
        updating = false
  action testAlert
    showNotification(title="Magnitor alerts are on", body="This is how Magnitor tells you when your Mac crosses a limit you set.", tag="test")
  // Each pulse: the reading from the last one is checked against the limits, and the widget's
  // reading is written each minute (and at once when what it shows changes).
  action watch
    pulse = pulse + 1
    let now = performanceNow()
    if now - diskAt >= 60000
      diskPulse = diskPulse + 1
      diskAt = now
    if vitals.pressure != ""
      if alertsOn and cpuLimit > 0 and vitals.cpu >= cpuLimit
        if cpuSince == 0
          cpuSince = now
        else if not cpuAlerted and now - cpuSince >= sustain * 1000
          cpuAlerted = true
          showNotification(title="CPU usage is high", body=`Your Mac’s CPU has been over ${cpuLimit}% for ${sustainText(sustain)}, and is at ${round(vitals.cpu)}% now. Open Activity Monitor in Magnitor to see what’s using it.`, tag="cpu")
      else
        cpuSince = 0
        if vitals.cpu < cpuLimit - 10 or not alertsOn
          cpuAlerted = false
      if alertsOn and memoryLimit > 0 and vitals.memory >= memoryLimit
        if memorySince == 0
          memorySince = now
        else if not memoryAlerted and now - memorySince >= sustain * 1000
          memoryAlerted = true
          showNotification(title="Memory is running low", body=`${round(vitals.memory)}% of your Mac’s memory is in use, over your ${memoryLimit}% limit. Quitting apps you aren’t using frees it.`, tag="memory")
      else
        memorySince = 0
        if vitals.memory < memoryLimit - 5 or not alertsOn
          memoryAlerted = false
    if disk.freeBytes > 0
      if alertsOn and diskLimit > 0 and disk.freeBytes < diskLimit * 1000000000
        if not diskAlerted
          diskAlerted = true
          showNotification(title="Your disk is almost full", body=`Only ${disk.free} is free. Open Magnitor to see what’s using the space.`, tag="disk")
      else if disk.freeBytes > diskLimit * 1200000000 or not alertsOn
        diskAlerted = false
    // A process behaving unusually: one post a pulse, each id once.
    if procWatch
      match procNext.at(0)
        case some(f)
          procAlerted = procAlerted.slice(max(0, procAlerted.length - 49)).concat([f.id])
          showNotification(title=f.title, body=f.body, tag=`process-${f.kind}`, data=`${f.pid}`)
        case none
          procAlerted = procAlerted
      if now - procAt >= 10000
        procPulse = procPulse + 1
        procAt = now
    // Once a month, Developer Files is found afresh, and a reminder posted when what it suggests
    // passes the chosen size. The first month counts from when the reminder is first on.
    if alertsOn and cleanRemind > 0 and clock.epochAtZero > 0
      let epoch = clock.epochAtZero + now
      if remindCheckedAt == 0
        remindCheckedAt = epoch
      else if reminderScan
        if current(dev)
          reminderScan = false
          remindCheckedAt = epoch
          if dev.error == "" and suggestedBytes >= cleanRemind * 1000000000
            showNotification(title=`${sizeText(suggestedBytes)} of developer files to clean up`, body="Old build folders and caches you can rebuild are taking space. Open Developer Files to choose what goes to the Trash.", tag="dev")
      else if epoch - remindCheckedAt >= 2592000000
        reminderScan = true
        generation = generation + 1
    if widgetOn and vitals.pressure != "" and (widgetAt == 0 or now - widgetAt >= 60000 or widgetShown != widgetShows)
      send widgetSaved = saveWidget(widgetShows, round(vitals.cpu), round(vitals.memory), vitals.pressure, disk.free, disk.size > 0 ? disk.freeBytes / disk.size : 0, clock.epochAtZero + now)
      widgetAt = now
      widgetShown = widgetShows
  action pick(t: string)
    tab = t
    storageSeen = storageSeen or t == "storage"
  // Put away (Linux's tray window closed) while Settings shows: the next opening is the panel.
  action popover(e: ToggleEvent)
    shown = e.newState == "open"
    if not shown and settingsBelow
      nav = back(nav)
  action sample
    tick = tick + 1
  action search(v: string)
    query = v
    endNotice = ""
    selected = -1
  action order(key: string)
    sort = key
  action openProcess(pid: number)
    inspected = pid
    ending = ""
    endNotice = ""
  // A row: an app's opens its processes together, a process's opens that process.
  action openRow(pid: number, app: string, group: bool)
    if group
      inspectedApp = app
      appEnding = ""
    else
      inspected = pid
      ending = ""
    endNotice = ""
    selected = pid
  // A row's actions menu (right-click, or ⌘K on the highlighted row) notes which row it is for.
  action aim(pid: number, app: string, name: string, group: bool, mine: bool)
    aimedPid = pid
    aimedApp = app
    aimedName = name
    aimedGroup = group
    aimedMine = mine
    selected = pid
  action openAimed
    if aimedGroup
      inspectedApp = aimedApp
      appEnding = ""
    else
      inspected = aimedPid
      ending = ""
    endNotice = ""
  // Quit and Force Quit from the menu end the row at once, as Raycast's do, and the list says
  // how it went (`endNotice`). An app's row ends its main process; its helpers end with it.
  // The data refuses Magnitor itself and macOS's first processes, saying so.
  action endAimed(how: string)
    if aimedGroup
      send appEnded = endApp(aimedApp, how)
    else
      send ended = endProcess(aimedPid, how == "force")
    endNotice = ""
  // The list's keys, from the search field or with nothing focused: ↑ and ↓ move the
  // highlight, Enter opens the highlighted row, and ⌘K opens its actions menu.
  action listKey(k: string, e: KeyboardEvent)
    if listKeys and not e.isComposing and tasks.processes.length > 0
      let plain = not (e.metaKey or e.ctrlKey or e.altKey)
      let last = tasks.processes.length - 1
      if plain and (k == "ArrowDown" or k == "ArrowUp")
        let at = k == "ArrowDown" ? (highlighted == -1 ? 0 : (highlighted < last ? highlighted + 1 : last)) : (highlighted <= 0 ? 0 : highlighted - 1)
        let pid = pidAt(tasks.processes, at)
        selected = pid
        scrollIntoView(`proc-row-${pid}`, block="nearest")
        preventDefault()
      else if plain and k == "Enter" and highlighted != -1
        match tasks.processes.at(highlighted)
          case some(p)
            if p.group
              inspectedApp = p.app
              appEnding = ""
            else
              inspected = p.pid
              ending = ""
            endNotice = ""
            selected = p.pid
          case none
            selected = -1
        preventDefault()
      else if (e.metaKey or e.ctrlKey) and e.code == "KeyK"
        match tasks.processes.at(highlighted == -1 ? 0 : highlighted)
          case some(p)
            aimedPid = p.pid
            aimedApp = p.app
            aimedName = p.name
            aimedGroup = p.group
            aimedMine = p.mine
            selected = p.pid
            showPopover("proc-menu", source=`proc-row-${p.pid}`)
            focus("menu-open")
          case none
            selected = -1
        preventDefault()
    else if portKeys and not e.isComposing and portRows.length > 0
      let plain = not (e.metaKey or e.ctrlKey or e.altKey)
      let last = portRows.length - 1
      if plain and (k == "ArrowDown" or k == "ArrowUp")
        let at = k == "ArrowDown" ? (portAt == -1 ? 0 : (portAt < last ? portAt + 1 : last)) : (portAt <= 0 ? 0 : portAt - 1)
        match portRows.at(at)
          case some(s)
            portSelected = portKey(s)
            scrollIntoView(`port-row-${s.pid}-${s.port}`, block="nearest")
          case none
            portSelected = ""
        preventDefault()
      else if plain and k == "Enter" and portAt != -1
        match portRows.at(portAt)
          case some(s)
            portPid = s.pid
            portNumber = s.port
            portEnding = ""
            portNotice = ""
          case none
            portSelected = ""
        preventDefault()
      else if (e.metaKey or e.ctrlKey) and e.code == "KeyK"
        match portRows.at(portAt == -1 ? 0 : portAt)
          case some(s)
            aimedServerPid = s.pid
            aimedServerPort = s.port
            portSelected = portKey(s)
            showPopover("port-menu", source=`port-row-${s.pid}-${s.port}`)
            focus("port-menu-first")
          case none
            portSelected = ""
        preventDefault()
  action closeApp
    inspectedApp = ""
    appEnding = ""
    endNotice = ""
  action toggleGrouped
    grouped = not grouped
  action askAppEnd(how: string)
    appEnding = how
    endNotice = ""
  action cancelAppEnd
    appEnding = ""
  action confirmAppEnd
    send appEnded = endApp(inspectedApp, appEnding)
    appEnding = ""
  action afterAppEnd
    match appEnded
      case some(r)
        endNotice = r.message
        if r.ok
          tick = tick + 1
      case none
        endNotice = ""
  action copyPath(path: string)
    copyText(path)
    endNotice = "Copied the path."
  action closeProcess
    inspected = -1
    ending = ""
  action askEnd(how: string)
    ending = how
    endNotice = ""
  action cancelEnd
    ending = ""
  action confirmEnd
    send ended = endProcess(inspected, ending == "force")
    ending = ""
  action afterEnd
    match ended
      case some(r)
        endNotice = r.message
        if r.ok
          inspected = -1
          tick = tick + 1
      case none
        endNotice = ""
  action rescan
    generation = generation + 1
    toolsGeneration = toolsGeneration + 1
    gone = []
    flipped = []
    cleanNotice = ""
  action openFolder(id: string)
    opened = id
  action back
    opened = ""
  action showInFinder(path: string)
    send revealed = reveal(path)
  // Developer Files.
  action openCleanup
    cleaning = true
    cleanConfirm = false
    cleanNotice = ""
  action closeCleanup
    cleaning = false
    cleanConfirm = false
    purgeConfirm = false
    cmdAsk = ""
  // A checkbox: chosen or not, kept as a flip from the item's suggestion.
  action choose(path: string, suggested: bool, on: bool)
    flipped = on != suggested ? (flipped.includes(path) ? flipped : flipped.concat([path])) : flipped.filter(p => p != path)
    cleanConfirm = false
    cleanNotice = ""
  action chooseSuggested
    flipped = []
    cleanConfirm = false
  action chooseAll
    flipped = devItems.filter(i => not i.suggested).map(i => i.path)
    cleanConfirm = false
  action chooseNone
    flipped = devItems.filter(i => i.suggested).map(i => i.path)
    cleanConfirm = false
  action askClean
    cleanConfirm = true
    purgeConfirm = false
    cmdAsk = ""
    cleanNotice = ""
  action cancelClean
    cleanConfirm = false
  action confirmClean
    send trashed = trashItems(chosen.map(i => i.path), chosenBytes, scanFolders)
    cleanConfirm = false
  // What moved leaves the list, and the folders are measured again: the pie's Xcode build
  // data shrinks with it.
  action afterTrash
    match trashed
      case some(r)
        cleanNotice = r.message
        if r.moved.length > 0
          trashedPaths = trashedPaths.concat(r.moved)
          trashedBytes = trashedBytes + sum(dev.items.filter(i => r.moved.includes(i.path)).map(i => i.bytes))
          gone = gone.concat(r.moved)
          flipped = []
          generation = generation + 1
      case none
        cleanNotice = ""
  // Delete Now: what Magnitor moved to the Trash, deleted for good, asked first.
  action askPurge
    purgeConfirm = true
    cleanConfirm = false
    cmdAsk = ""
    cleanNotice = ""
  action cancelPurge
    purgeConfirm = false
  action confirmPurge
    send purged = purgeTrashed(trashedPaths, trashedBytes)
    purgeConfirm = false
  action afterPurge
    match purged
      case some(r)
        cleanNotice = r.message
        if r.moved.length > 0
          trashedBytes = r.moved.length >= trashedPaths.length ? 0 : round(trashedBytes * (trashedPaths.length - r.moved.length) / trashedPaths.length)
          trashedPaths = trashedPaths.filter(p => not r.moved.includes(p))
          diskPulse = diskPulse + 1
      case none
        cleanNotice = ""
  // A tool's command: asked first, then run in Rust; or copied, when Magnitor can't run it.
  action askCmd(id: string)
    cmdAsk = id
    cleanConfirm = false
    purgeConfirm = false
    cleanNotice = ""
  action cancelCmd
    cmdAsk = ""
  action confirmCmd
    send cmdRan = runDevCommand(cmdAsk)
    cmdAsk = ""
  action afterCmd
    match cmdRan
      case some(r)
        cleanNotice = r.message
        if r.ok
          toolsGeneration = toolsGeneration + 1
          diskPulse = diskPulse + 1
      case none
        cleanNotice = ""
  action copyCmd(command: string)
    copyText(command)
    cleanNotice = "Copied the command. Paste it in Terminal to run it."
  // Settings' folders for Developer Files, chosen with the system's folder picker.
  action addScanFolder
    showDirectoryPicker("scan-add")
  action addScanSkip
    showDirectoryPicker("scan-skip")
  action pickedScanFolder(value: string)
    send pickedAdd = folderPath(value)
  action pickedScanSkip(value: string)
    send pickedSkip = folderPath(value)
  action afterPickAdd
    match pickedAdd
      case some(r)
        if r.path != "" and not scanFolders.includes(r.path)
          scanFolders = scanFolders.concat([r.path])
      case none
        scanFolders = scanFolders
  action afterPickSkip
    match pickedSkip
      case some(r)
        if r.path != "" and not scanSkip.includes(r.path)
          scanSkip = scanSkip.concat([r.path])
      case none
        scanSkip = scanSkip
  action removeScanFolder(f: string)
    scanFolders = scanFolders.filter(x => x != f)
  action removeScanSkip(f: string)
    scanSkip = scanSkip.filter(x => x != f)
  action setCleanRemind(v: string)
    cleanRemind = number(v)
  // Ports.
  action openPort(pid: number, port: number)
    portPid = pid
    portNumber = port
    portSelected = `${pid}:${port}`
    portEnding = ""
    portNotice = ""
  action closePort
    portPid = -1
    portNumber = -1
    portEnding = ""
  action aimPort(pid: number, port: number)
    aimedServerPid = pid
    aimedServerPort = port
  action toggleOthers
    othersShown = not othersShown
  action openLink(url: string)
    send revealed = openUrl(url)
  // A row's Stop: at once, as Raycast's Kill Process is; the details ask first.
  action stopServer(pid: number, port: number, force: bool)
    send portStopped = stopPort(pid, port, force)
    portNotice = ""
  action askPortEnd(how: string)
    portEnding = how
    portNotice = ""
  action cancelPortEnd
    portEnding = ""
  action confirmPortEnd
    send portStopped = stopPort(portPid, portNumber, portEnding == "force")
    portEnding = ""
  action copyUrl(url: string)
    copyText(url)
    portNotice = "Copied the URL."
  action copyCommand(command: string)
    copyText(command)
    portNotice = "Copied the command."
  action afterPortStop
    match portStopped
      case some(r)
        portNotice = r.message
        if r.ok
          portPid = -1
          portNumber = -1
          tick = tick + 1
      case none
        portNotice = ""

  view
    main testId="root" navigationKey=`${top(nav).id}` navigate=follow globalshortcut=hotkeyPressed notificationclick=notified key=listKey width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "home"
          column navigationKey=`${e.id}` position="absolute" inset=0
            // The menu bar item on macOS; elsewhere an ordinary button. With the load shown it
            // has no image: AppKit draws the title, the label, in its place.
            button id="status-item" -exact-menu="status" popovertarget="stats" aria-label=trayLabel testId="status-item"
              if trayShow == "icon"
                image trayIconSymbol(trayIcon)
          column id="stats" popover=(tray ? "manual" : "auto") toggle=popover width=360 height=600 visibility=(settingsBelow ? "hidden" : "visible") display="flex" flex-direction="column" testId="stats"
            // The segmented control: the platform's, between two boxes of one width so it stays centred.
            row align-items="center" gap=4 padding-top=12 padding-left=12 padding-right=12 padding-bottom=8
              column width=32
              row flex=1 justify-content="center"
                row role="tablist" appearance="none" aria-label="View" class=GlassTrack testId="tabs"
                  button role="tab" aria-controls="panel-tasks" aria-selected=(tab == "tasks") press=pick("tasks") class=(tab == "tasks" ? SegmentOn : Segment) testId="tab-tasks"
                    text "Activity" class=(tab == "tasks" ? LabelOn : Label)
                  button role="tab" aria-controls="panel-storage" aria-selected=(tab == "storage") press=pick("storage") class=(tab == "storage" ? SegmentOn : Segment) testId="tab-storage"
                    text "Storage" class=(tab == "storage" ? LabelOn : Label)
                  button role="tab" aria-controls="panel-ports" aria-selected=(tab == "ports") press=pick("ports") class=(tab == "ports" ? SegmentOn : Segment) testId="tab-ports"
                    text "Ports" class=(tab == "ports" ? LabelOn : Label)
              column width=32 align-items="flex-end"
                if tab == "storage" and opened == ""
                  if measuring and usage.total != ""
                    progress aria-label="Measuring again" testId="remeasuring"
                  else
                    button press=rescan disabled=measuring aria-label="Measure Again" padding=6 border-radius=6 color="-exact-secondary-label" testId="rescan"
                      image "symbol:refresh"
            column role="region" id="panel-storage" aria-label="Storage" flex=1 min-height=0 display=(tab == "storage" ? "flex" : "none") flex-direction="column"
              if cleaning
                // Developer Files: each project folder and cache with a checkbox, the suggested
                // ones checked, and the amount chosen as the screen's one number.
                row align-items="center" gap=6 padding-top=10 padding-left=8 padding-right=16 padding-bottom=6
                  button press=closeCleanup aria-label="Back" padding=6 border-radius=6 testId="clean-back"
                    image "symbol:back"
                  text "Developer Files" role="heading" aria-level=1 font="-exact-headline" flex=1 testId="clean-title"
                  if finding
                    progress aria-label="Finding developer files" testId="clean-finding"
                  else
                    text devTotalText color="-exact-secondary-label" font-variant-numeric="tabular-nums" testId="clean-total"
                scroll id="cleanup" flex=1 min-height=0 scrollbar-width="none"
                  column gap=12 padding-left=12 padding-right=12 padding-bottom=12
                    if dev.error != ""
                      text dev.error color="-exact-secondary-label" text-align="center" padding-top=40 testId="clean-error"
                    else if finding and devItems.length == 0
                      column align-items="center" gap=12 padding-top=80 padding-bottom=80
                        progress aria-label="Finding developer files"
                        text "Looking for build folders and caches…" color="-exact-secondary-label" testId="clean-reading"
                    else if devItems.length == 0
                      column align-items="center" gap=8 padding-top=60 padding-left=24 padding-right=24
                        image "symbol:select" font="-exact-large-title" color="-exact-system-green" aria-hidden=true
                        text "Nothing to clean up" font="-exact-headline" testId="clean-empty"
                        text "Your projects’ node_modules, build folders and your tools’ caches appear here when they take space." font="-exact-footnote" color="-exact-secondary-label" text-align="center"
                    else
                      column align-items="center" gap=2 padding-top=4
                        text sizeText(chosenBytes) font="-exact-title1" font-weight=700 font-variant-numeric="tabular-nums" testId="clean-chosen"
                        text `chosen · ${itemsText(chosen.length)}` font="-exact-footnote" color="-exact-secondary-label" testId="clean-count"
                        row gap=4 padding-top=6 role="group" aria-label="Choose"
                          button press=chooseSuggested class=Chip testId="clean-suggested"
                            text "Suggested" font="-exact-footnote" font-weight=500
                          button press=chooseAll class=Chip testId="clean-all"
                            text "All" font="-exact-footnote" font-weight=500
                          button press=chooseNone class=Chip testId="clean-none"
                            text "None" font="-exact-footnote" font-weight=500
                      if devProjects.length > 0
                        column gap=6
                          row align-items="baseline" padding-left=4 padding-right=4
                            text "Projects" font="-exact-subheadline" font-weight=600 color="-exact-secondary-label" flex=1
                            text "Rebuilt when you install or build" font="-exact-caption1" color="-exact-tertiary-label"
                          column background-color="light-dark(rgba(0,0,0,0.05), rgba(255,255,255,0.07))" border-radius=12 padding-left=10 padding-right=6
                            for i, n in devProjects key=i.path
                              DevRow(item=i, on=chosenNow(i, flipped), first=(n == 0), id=`dev-project-${n}`, choose=choose(i.path, i.suggested), reveal=showInFinder(i.path))
                      if devCaches.length > 0
                        column gap=6
                          row align-items="baseline" padding-left=4 padding-right=4
                            text "Caches" font="-exact-subheadline" font-weight=600 color="-exact-secondary-label" flex=1
                            text "Your tools fill them again as needed" font="-exact-caption1" color="-exact-tertiary-label"
                          column background-color="light-dark(rgba(0,0,0,0.05), rgba(255,255,255,0.07))" border-radius=12 padding-left=10 padding-right=6
                            for i, n in devCaches key=i.path
                              DevRow(item=i, on=chosenNow(i, flipped), first=(n == 0), id=`dev-cache-${n}`, choose=choose(i.path, i.suggested), reveal=showInFinder(i.path))
                      if dev.more > 0
                        text `And ${dev.more} smaller project ${dev.more == 1 ? "folder" : "folders"}, counted in the total.` font="-exact-footnote" color="-exact-secondary-label" text-align="center" testId="clean-more"
                    // What the Trash can't take: each freed by its own tool's command.
                    if devCmds.commands.length > 0
                      column gap=6
                        row align-items="baseline" padding-left=4 padding-right=4
                          text "Tools" font="-exact-subheadline" font-weight=600 color="-exact-secondary-label" flex=1
                          text "Freed by the tool that owns them" font="-exact-caption1" color="-exact-tertiary-label"
                        column background-color="light-dark(rgba(0,0,0,0.05), rgba(255,255,255,0.07))" border-radius=12 padding-left=10 padding-right=10
                          for c, n in devCmds.commands key=c.id
                            CommandRow(cmd=c, first=(n == 0), id=`dev-cmd-${c.id}`, run=askCmd(c.id), copy=copyCmd(c.command))
                // The action stays in view under the list, and asks first, in the popover: an
                // alert would close it.
                column gap=8 padding-left=12 padding-right=12 padding-top=8 padding-bottom=4 border-top="1px solid -exact-separator"
                  if cleanNotice != ""
                    text cleanNotice font="-exact-footnote" color="-exact-secondary-label" testId="clean-notice"
                  if cmdAsk != ""
                    for c in cmdAsked key=c.id
                      text cmdText(c) font="-exact-footnote" testId="cmd-confirm-text"
                    row gap=8 justify-content="flex-end"
                      button press=cancelCmd padding-top=7 padding-bottom=7 padding-left=12 padding-right=12 border-radius=8 background-color="light-dark(rgba(0,0,0,0.08), rgba(255,255,255,0.12))" testId="cmd-cancel"
                        text "Cancel"
                      button press=confirmCmd padding-top=7 padding-bottom=7 padding-left=12 padding-right=12 border-radius=8 background-color="-exact-system-red" testId="cmd-confirm"
                        text "Run" color="white" font-weight=600
                  else if purgeConfirm
                    text purgeText(trashedPaths.length, trashedBytes) font="-exact-footnote" testId="purge-confirm-text"
                    row gap=8 justify-content="flex-end"
                      button press=cancelPurge padding-top=7 padding-bottom=7 padding-left=12 padding-right=12 border-radius=8 background-color="light-dark(rgba(0,0,0,0.08), rgba(255,255,255,0.12))" testId="purge-cancel"
                        text "Cancel"
                      button press=confirmPurge padding-top=7 padding-bottom=7 padding-left=12 padding-right=12 border-radius=8 background-color="-exact-system-red" testId="purge-confirm"
                        text "Delete" color="white" font-weight=600
                  else if cleanConfirm
                    text cleanText(chosen.length, chosenBytes) font="-exact-footnote" testId="clean-confirm-text"
                    row gap=8 justify-content="flex-end"
                      button press=cancelClean padding-top=7 padding-bottom=7 padding-left=12 padding-right=12 border-radius=8 background-color="light-dark(rgba(0,0,0,0.08), rgba(255,255,255,0.12))" testId="clean-cancel"
                        text "Cancel"
                      button press=confirmClean padding-top=7 padding-bottom=7 padding-left=12 padding-right=12 border-radius=8 background-color="-exact-system-red" testId="clean-confirm"
                        text "Move to Trash" color="white" font-weight=600
                  else
                    button press=askClean disabled=(chosen.length == 0 or pending(trashed)) padding-top=8 padding-bottom=8 border-radius=8 align-items="center" justify-content="center" background-color=(chosen.length == 0 ? "light-dark(rgba(0,0,0,0.08), rgba(255,255,255,0.12))" : "-exact-system-blue") testId="clean-go"
                      text (pending(trashed) ? "Moving to the Trash…" : chosen.length == 0 ? "Choose What to Clean Up" : `Move ${sizeText(chosenBytes)} to the Trash`) font-weight=600 color=(chosen.length == 0 ? "-exact-secondary-label" : "white") testId="clean-go-label"
                    // Moved items free nothing until the Trash is emptied: these alone, at once.
                    if trashedPaths.length > 0
                      button press=askPurge disabled=pending(purged) padding-top=6 padding-bottom=6 border-radius=8 align-items="center" justify-content="center" background-color="light-dark(rgba(0,0,0,0.08), rgba(255,255,255,0.12))" testId="purge"
                        text (pending(purged) ? "Deleting…" : `Delete ${sizeText(trashedBytes)} from the Trash Now`) font="-exact-footnote" font-weight=500 testId="purge-label"
              else if opened == ""
                scroll id="content" flex=1 min-height=0 scrollbar-width="none"
                  column gap=14 padding-left=12 padding-right=12 padding-bottom=8
                    if usage.error != ""
                      text usage.error color="-exact-secondary-label" text-align="center" padding-top=40 testId="error"
                    else if usage.total == "" and measuring
                      column align-items="center" gap=12 padding-top=60 padding-bottom=60
                        progress aria-label="Measuring"
                        text "Measuring your folders…" color="-exact-secondary-label" testId="measuring"
                    else if usage.slices.length == 0
                      text "None of the folders Magnitor measures has anything in it." color="-exact-secondary-label" text-align="center" padding-top=40 testId="empty"
                    else
                      column align-items="center" gap=8
                        column position="relative" width=190 height=190 testId="chart"
                          svg width=190 height=190 viewBox="0 0 200 200" role="img" aria-label=`Storage by folder, ${usage.total} in all`
                            for s in usage.slices key=s.id
                              path d=s.path fill=sliceColor(s.id)
                          for s in usage.slices key=s.id
                            if s.labelled
                              // A box centred on the label's point holds it.
                              column position="absolute" left=`${s.labelX}%` top=`${s.labelY}%` width=44 height=16 margin-left=-22 margin-top=-8 align-items="center" justify-content="center" aria-hidden=true
                                text s.percent font="-exact-caption2" font-weight=700 color="white" font-variant-numeric="tabular-nums"
                          column position="absolute" inset=0 align-items="center" justify-content="center"
                            text usage.total font="-exact-title2" font-weight=700 font-variant-numeric="tabular-nums" testId="total"
                        if diskText != ""
                          text diskText font="-exact-footnote" color="-exact-secondary-label" text-align="center" testId="disk"
                          progress value=(usage.totalBytes / disk.size) aria-label="Share of the disk" width=200
                      // Developer Files: the build folders and caches a developer can clear.
                      button press=openCleanup aria-label=`Developer Files: ${devCardText}` display="flex" flex-direction="row" gap=10 align-items="center" padding=10 border-radius=12 background-color="light-dark(rgba(0,0,0,0.05), rgba(255,255,255,0.07))" testId="dev-card"
                        column width=32 height=32 border-radius=8 background-color="-exact-system-blue" align-items="center" justify-content="center" flex-shrink=0 aria-hidden=true
                          image "symbol:sf/hammer.fill" font="-exact-subheadline" color="white"
                        column flex=1 min-width=0 gap=1 text-align="left"
                          text "Developer Files" font-weight=600
                          text devCardText font="-exact-caption1" color="-exact-secondary-label" testId="dev-summary"
                        if finding
                          progress aria-label="Finding developer files"
                        image "symbol:forward-chevron" color="-exact-tertiary-label" aria-hidden=true
                      for g in groups key=g
                        column gap=6
                          text groupTitle(g) font="-exact-subheadline" font-weight=600 color="-exact-secondary-label" padding-left=4
                          column background-color="light-dark(rgba(0,0,0,0.05), rgba(255,255,255,0.07))" border-radius=12 padding-left=12 padding-right=12
                            column
                              for s, i in usage.slices.filter(x => x.group == g) key=s.id
                                // The folder's row opens what is in it.
                                button press=openFolder(s.id) aria-label=`${s.name}, ${s.size}, ${s.percent}` display="flex" flex-direction="row" gap=10 align-items="center" padding-top=10 padding-bottom=10 border-top=(i == 0 ? "none" : "1px solid -exact-separator") testId=`slice-${s.id}`
                                  column width=12 height=12 border-radius=6 background-color=sliceColor(s.id) aria-hidden=true
                                  text s.name testId=`name-${s.id}`
                                  text s.percent color="-exact-secondary-label" font-variant-numeric="tabular-nums" testId=`percent-${s.id}`
                                  column flex=1
                                  text s.size color="-exact-secondary-label" font-variant-numeric="tabular-nums" testId=`size-${s.id}`
                                  image "symbol:forward-chevron" color="-exact-tertiary-label" aria-hidden=true
              else
                // One folder's contents, largest first.
                row align-items="center" gap=6 padding-top=10 padding-left=8 padding-right=16 padding-bottom=6
                  button press=back aria-label="Back" padding=6 border-radius=6 testId="back"
                    image "symbol:back"
                  text openedName role="heading" aria-level=1 font="-exact-headline" flex=1 testId="folder-name"
                  if not listing
                    text contents.total color="-exact-secondary-label" font-variant-numeric="tabular-nums" testId="folder-total"
                scroll id="folder" flex=1 min-height=0 scrollbar-width="none"
                  column padding-left=12 padding-right=12 padding-bottom=12
                    if listing
                      column align-items="center" gap=12 padding-top=80 padding-bottom=80
                        progress aria-label="Listing"
                        text `Listing ${openedName}…` color="-exact-secondary-label" testId="listing"
                    else if contents.error != ""
                      text contents.error color="-exact-secondary-label" text-align="center" padding-top=40 testId="folder-error"
                    else if items.length == 0
                      text "Nothing in this folder." color="-exact-secondary-label" text-align="center" padding-top=40 testId="folder-empty"
                    else
                      column background-color="light-dark(rgba(0,0,0,0.05), rgba(255,255,255,0.07))" border-radius=12 padding-left=12 padding-right=6
                        for it, i in items key=it.path
                          row gap=8 align-items="center" padding-top=8 padding-bottom=8 border-top=(i == 0 ? "none" : "1px solid -exact-separator") testId=`item-${i}`
                            column flex=1 min-width=0 gap=1
                              text shownName(names, i, it) text-overflow="ellipsis" white-space="nowrap" overflow="hidden" testId=`item-name-${i}`
                              if shownDetail(names, i, it) != ""
                                text shownDetail(names, i, it) font="-exact-caption1" color="-exact-secondary-label" text-overflow="ellipsis" white-space="nowrap" overflow="hidden" testId=`item-detail-${i}`
                            column align-items="flex-end" gap=1
                              text it.size font-variant-numeric="tabular-nums" testId=`item-size-${i}`
                              text it.percent font="-exact-caption1" color="-exact-secondary-label" font-variant-numeric="tabular-nums" testId=`item-percent-${i}`
                            button press=showInFinder(it.path) aria-label=`Show ${it.name} in Finder` padding=6 border-radius=6 color="-exact-secondary-label" testId=`item-reveal-${i}`
                              image "symbol:search"
            column role="region" id="panel-tasks" aria-label="Activity Monitor" flex=1 min-height=0 display=(tab == "tasks" ? "flex" : "none") flex-direction="column" testId="tasks"
              if inspected == -1 and inspectedApp == ""
                column gap=10 padding-left=12 padding-right=12 padding-bottom=8
                  // The machine: CPU load as Activity Monitor graphs it, and memory with its pressure.
                  row gap=10
                    column flex=1 min-width=0 gap=6 padding=10 border-radius=12 background-color="light-dark(rgba(0,0,0,0.05), rgba(255,255,255,0.07))" testId="cpu-card"
                      row align-items="baseline" gap=4
                        text "CPU" font="-exact-subheadline" font-weight=600 color="-exact-secondary-label" flex=1
                        if tasks.cpuIdle != ""
                          text `${tasks.cpuIdle}% idle` font="-exact-caption1" color="-exact-secondary-label" font-variant-numeric="tabular-nums" testId="cpu-idle"
                      column border-radius=6 overflow="hidden" background-color="light-dark(rgba(0,0,0,0.05), rgba(255,255,255,0.06))" align-items="center"
                        svg width=140 height=44 viewBox="0 0 140 44" role="img" aria-label=`CPU load: ${tasks.cpuUser}% user, ${tasks.cpuSystem}% system` testId="cpu-graph"
                          path d=tasks.systemPath fill="-exact-system-red"
                          path d=tasks.userPath fill="-exact-system-blue"
                      row gap=6 align-items="center"
                        column width=8 height=8 border-radius=4 background-color="-exact-system-red" aria-hidden=true
                        text "System" font="-exact-caption1" color="-exact-secondary-label" flex=1
                        text `${tasks.cpuSystem}%` font="-exact-caption1" font-variant-numeric="tabular-nums" testId="cpu-system"
                      row gap=6 align-items="center"
                        column width=8 height=8 border-radius=4 background-color="-exact-system-blue" aria-hidden=true
                        text "User" font="-exact-caption1" color="-exact-secondary-label" flex=1
                        text `${tasks.cpuUser}%` font="-exact-caption1" font-variant-numeric="tabular-nums" testId="cpu-user"
                      if tasks.thermal != ""
                        row gap=6 align-items="center"
                          column width=8 height=8 border-radius=4 background-color=thermalColor(tasks.thermal) aria-hidden=true
                          text "Thermal" font="-exact-caption1" color="-exact-secondary-label" flex=1
                          // The degrees where the Mac has die sensors; coloured by the state, the
                          // public and reliable signal.
                          text (tasks.temperature == "" ? tasks.thermal : `${tasks.temperature} · ${tasks.thermal}`) font="-exact-caption1" font-weight=600 color=thermalColor(tasks.thermal) font-variant-numeric="tabular-nums" testId="thermal"
                    column flex=1 min-width=0 gap=6 padding=10 border-radius=12 background-color="light-dark(rgba(0,0,0,0.05), rgba(255,255,255,0.07))" testId="memory-card"
                      row align-items="baseline" gap=4
                        text "Memory" font="-exact-subheadline" font-weight=600 color="-exact-secondary-label" flex=1
                        if tasks.pressure != ""
                          text tasks.pressure font="-exact-caption1" font-weight=600 color=pressureColor(tasks.pressure) testId="pressure"
                      column gap=1
                        text tasks.memoryUsed font="-exact-title3" font-weight=700 font-variant-numeric="tabular-nums" testId="memory-used"
                        text (tasks.memoryTotal == "" ? " " : `used of ${tasks.memoryTotal}`) font="-exact-caption1" color="-exact-secondary-label" font-variant-numeric="tabular-nums" testId="memory-total"
                      // The share used, in the colour of the pressure.
                      column height=6 border-radius=3 background-color="light-dark(rgba(0,0,0,0.08), rgba(255,255,255,0.1))" overflow="hidden" role="meter" aria-label="Memory used" aria-valuenow=round(tasks.memoryShare * 100) aria-valuemin=0 aria-valuemax=100
                        column width=`${tasks.memoryShare * 100}%` height=6 background-color=pressureColor(tasks.pressure)
                      row gap=6
                        text "Cached" font="-exact-caption1" color="-exact-secondary-label" flex=1
                        text tasks.cached font="-exact-caption1" font-variant-numeric="tabular-nums" testId="memory-cached"
                      // Least to most serious: cached files go freely, compression comes first under
                      // pressure, swap last.
                      row gap=6
                        text "Compressed" font="-exact-caption1" color="-exact-secondary-label" flex=1
                        text tasks.compressed font="-exact-caption1" font-variant-numeric="tabular-nums" testId="memory-compressed"
                      row gap=6
                        text "Swap" font="-exact-caption1" color="-exact-secondary-label" flex=1
                        text tasks.swap font="-exact-caption1" font-variant-numeric="tabular-nums" testId="memory-swap"
                  row gap=8 align-items="center"
                    input type="search" value=query input=search placeholder="Search" aria-label="Search Processes" aria-controls="process-rows" aria-activedescendant=(highlighted == -1 ? "" : `proc-row-${pidAt(tasks.processes, highlighted)}`) flex=1 min-width=0 testId="search"
                    row role="radiogroup" appearance="none" aria-label="Sort by" class=GlassTrack testId="sort"
                      for key in ["cpu", "memory", "name"] key=key
                        button role="radio" aria-checked=(sort == key) press=order(key) class=(sort == key ? SegmentOn : Segment) testId=`sort-${key}`
                          text sortLabel(key) class=(sort == key ? LabelOn : Label)
                  if endNotice != ""
                    text endNotice font="-exact-footnote" color="-exact-secondary-label" testId="end-notice"
                scroll id="processes" flex=1 min-height=0 scrollbar-width="none"
                  column padding-left=12 padding-right=12 padding-bottom=8 gap=6
                    if tasks.error != ""
                      text tasks.error color="-exact-secondary-label" text-align="center" padding-top=40 testId="tasks-error"
                    else if reading
                      column align-items="center" gap=12 padding-top=40 padding-bottom=40
                        progress aria-label="Reading processes"
                        text "Reading processes…" color="-exact-secondary-label" testId="reading"
                    else if tasks.processes.length == 0
                      text `No process matches “${query.trim()}”.` color="-exact-secondary-label" text-align="center" padding-top=40 testId="no-match"
                    else
                      column id="process-rows" background-color="light-dark(rgba(0,0,0,0.05), rgba(255,255,255,0.07))" border-radius=12 padding-left=12 padding-right=12
                        // The columns, the sorted one in bold, as Activity Monitor marks it.
                        row gap=8 padding-top=8 padding-bottom=6
                          // The first column's heading switches it: each app's processes as one
                          // row ("Apps"), or every process on its own ("Processes").
                          row flex=1 align-items="center"
                            button press=toggleGrouped aria-label="Group by App" aria-pressed=grouped display="flex" flex-direction="row" gap=4 align-items="center" testId="group"
                              image "symbol:sf/square.stack.3d.up" font="-exact-caption1" color=(grouped ? "-exact-system-blue" : "-exact-secondary-label") aria-hidden=true
                              text (grouped ? "Apps" : "Processes") font="-exact-caption1" color="-exact-secondary-label" font-weight=(sort == "name" ? 700 : 400)
                          text "% CPU" font="-exact-caption1" color="-exact-secondary-label" font-weight=(sort == "cpu" ? 700 : 400) width="3.5rem" text-align="right" aria-hidden=true
                          text "Memory" font="-exact-caption1" color="-exact-secondary-label" font-weight=(sort == "memory" ? 700 : 400) width="5rem" text-align="right" aria-hidden=true
                        for p, i in tasks.processes key=p.pid
                          // A row opens the process's inspector; a right-click its actions menu.
                          // The highlighted one (↑ ↓) is shaded, reaching a little past the text.
                          button id=`proc-row-${p.pid}` press=openRow(p.pid, p.app, p.group) contextmenu=aim(p.pid, p.app, p.name, p.group, p.mine) contextPopover="proc-menu" aria-label=rowLabel(p) display="flex" flex-direction="row" gap=8 align-items="center" padding-top=6 padding-bottom=6 margin-left=-6 margin-right=-6 padding-left=6 padding-right=6 border-radius=6 background-color=(i == highlighted ? "light-dark(rgba(0,0,0,0.08), rgba(255,255,255,0.1))" : "transparent") border-top="1px solid -exact-separator" testId=`proc-${i}`
                            ProcIcon(app=p.app, icon=iconAt(procIcons, i), id=`proc-icon-${i}`)
                            column flex=1 min-width=0 gap=1 text-align="left"
                              text p.name text-overflow="ellipsis" white-space="nowrap" overflow="hidden" testId=`proc-name-${i}`
                              text p.detail font="-exact-caption1" color="-exact-secondary-label" font-variant-numeric="tabular-nums" testId=`proc-detail-${i}`
                            text p.cpu font-variant-numeric="tabular-nums" width="3.5rem" text-align="right" testId=`proc-cpu-${i}`
                            text p.memory font-variant-numeric="tabular-nums" width="5rem" text-align="right" testId=`proc-memory-${i}`
                        // While searching: every match added up.
                        if tasks.matchCpu != ""
                          row gap=8 align-items="center" padding-top=8 padding-bottom=8 border-top="1px solid -exact-separator" testId="match-total"
                            text `Total · ${processes(tasks.matchCount)}` font-weight=600 flex=1 testId="match-count"
                            text tasks.matchCpu font-weight=600 font-variant-numeric="tabular-nums" width="3.5rem" text-align="right" testId="match-cpu"
                            text tasks.matchMemory font-weight=600 font-variant-numeric="tabular-nums" width="5rem" text-align="right" testId="match-memory"
                      text countText(tasks.count, tasks.more) font="-exact-caption1" color="-exact-secondary-label" text-align="center" testId="count"
                      // A row's actions, as Raycast's action panel: a right-click opens it at the
                      // pointer, ⌘K on the highlighted row.
                      column id="proc-menu" popover="auto" role="menu" aria-label=aimedName testId="proc-menu"
                        button press=openAimed popovertarget="proc-menu" popovertargetaction="hide" testId="menu-open"
                          text (aimedGroup ? "Show Processes" : "Show Info")
                        if aimedApp != ""
                          button press=showInFinder(aimedApp) popovertarget="proc-menu" popovertargetaction="hide" testId="menu-reveal"
                            text "Show in Finder"
                          button press=copyPath(aimedApp) popovertarget="proc-menu" popovertargetaction="hide" testId="menu-copy"
                            text "Copy Path"
                        hr
                        button press=endAimed("quit") disabled=(not aimedMine) popovertarget="proc-menu" popovertargetaction="hide" testId="menu-quit"
                          text "Quit"
                        button press=endAimed("force") disabled=(not aimedMine) destructive=true popovertarget="proc-menu" popovertargetaction="hide" testId="menu-force"
                          text "Force Quit"
              else if inspected == -1
                // One app's processes together: its totals, its actions, and each process.
                row align-items="center" gap=6 padding-left=8 padding-right=16 padding-bottom=6
                  button press=closeApp aria-label="Back" padding=6 border-radius=6 testId="app-back"
                    image "symbol:back"
                  text (appReady ? appInfo.name : "") role="heading" aria-level=1 font="-exact-headline" flex=1 min-width=0 testId="app-name"
                scroll id="app" flex=1 min-height=0 scrollbar-width="none"
                  column gap=10 padding-left=12 padding-right=12 padding-bottom=12
                    if not appReady
                      column align-items="center" gap=12 padding-top=80 padding-bottom=80
                        progress aria-label="Reading the app"
                    else if not appInfo.found
                      text `${appInfo.name} has quit.` color="-exact-secondary-label" text-align="center" padding-top=40 testId="app-gone"
                      if endNotice != ""
                        text endNotice font="-exact-footnote" color="-exact-secondary-label" text-align="center" testId="app-notice"
                    else
                      column background-color="light-dark(rgba(0,0,0,0.05), rgba(255,255,255,0.07))" border-radius=12 padding-left=12 padding-right=12
                        Field(label="Processes", value=`${appInfo.count}`, first=true, id="app-count")
                        Field(label="% CPU", value=appInfo.cpu, first=false, id="app-cpu")
                        Field(label="Memory", value=appInfo.memory, first=false, id="app-memory")
                        Field(label="Main Process ID", value=`${appInfo.main}`, first=false, id="app-main")
                      text appInfo.app font="-exact-caption1" color="-exact-secondary-label" padding-left=4 padding-right=4 testId="app-path"
                      row gap=8
                        button press=showInFinder(appInfo.app) class=Action testId="app-reveal"
                          text "Show in Finder"
                        button press=copyPath(appInfo.app) class=Action testId="app-copy"
                          text "Copy Path"
                      if endNotice != ""
                        text endNotice font="-exact-footnote" color="-exact-secondary-label" testId="app-notice"
                      // Confirmed here, in the popover: an alert would close it.
                      if appEnding != ""
                        text appEndText(appEnding, appInfo.name, appInfo.count) font="-exact-footnote" testId="app-confirm-text"
                        row gap=8 justify-content="flex-end"
                          button press=cancelAppEnd padding-top=7 padding-bottom=7 padding-left=12 padding-right=12 border-radius=8 background-color="light-dark(rgba(0,0,0,0.08), rgba(255,255,255,0.12))" testId="app-cancel"
                            text "Cancel"
                          button press=confirmAppEnd padding-top=7 padding-bottom=7 padding-left=12 padding-right=12 border-radius=8 background-color="-exact-system-red" testId="app-confirm"
                            text appEndLabel(appEnding) color="white" font-weight=600
                      else
                        // The main process (its helpers end with it), or every process; Restart
                        // opens the app again once it has gone.
                        row gap=8
                          button press=askAppEnd("quit") disabled=appLocked class=Action opacity=(appLocked ? 0.5 : 1) testId="app-quit"
                            text "Quit"
                          button press=askAppEnd("force") disabled=appLocked class=Action opacity=(appLocked ? 0.5 : 1) testId="app-force"
                            text "Force Quit"
                          button press=askAppEnd("restart") disabled=appLocked class=Action opacity=(appLocked ? 0.5 : 1) testId="app-restart"
                            text "Restart"
                        row gap=8
                          button press=askAppEnd("quitAll") disabled=appLocked class=Action opacity=(appLocked ? 0.5 : 1) testId="app-quit-all"
                            text "Quit All"
                          button press=askAppEnd("forceAll") disabled=appLocked class=Action opacity=(appLocked ? 0.5 : 1) testId="app-force-all"
                            text "Force Quit All"
                          button press=askAppEnd("forceRestart") disabled=appLocked class=Action opacity=(appLocked ? 0.5 : 1) testId="app-force-restart"
                            text "Force Restart"
                        if appInfo.own
                          text "This is Magnitor. To quit it, use Quit Magnitor." font="-exact-footnote" color="-exact-secondary-label" testId="app-why"
                        else if not appInfo.mine
                          text `Some of ${appInfo.name}’s processes belong to another user. You can quit only your own.` font="-exact-footnote" color="-exact-secondary-label" testId="app-why"
                      text "Processes" font="-exact-subheadline" font-weight=600 color="-exact-secondary-label" padding-left=4
                      column background-color="light-dark(rgba(0,0,0,0.05), rgba(255,255,255,0.07))" border-radius=12 padding-left=12 padding-right=12
                        for p, i in appInfo.processes key=p.pid
                          // A process opens its own inspector; Back returns here.
                          button press=openProcess(p.pid) aria-label=rowLabel(p) display="flex" flex-direction="row" gap=8 align-items="center" padding-top=6 padding-bottom=6 border-top=(i == 0 ? "none" : "1px solid -exact-separator") testId=`app-proc-${i}`
                            column flex=1 min-width=0 gap=1 text-align="left"
                              text p.name text-overflow="ellipsis" white-space="nowrap" overflow="hidden" testId=`app-proc-name-${i}`
                              text p.detail font="-exact-caption1" color="-exact-secondary-label" font-variant-numeric="tabular-nums"
                            text p.cpu font-variant-numeric="tabular-nums" width="3.5rem" text-align="right"
                            text p.memory font-variant-numeric="tabular-nums" width="5rem" text-align="right"
              else
                // One process, as Activity Monitor's inspector shows it. The headings here wrap
                // rather than clip: Linux's painter carries a heading's overflow clip onto the
                // content painted after it, cutting off its left edge.
                row align-items="center" gap=6 padding-left=8 padding-right=16 padding-bottom=6
                  button press=closeProcess aria-label="Back" padding=6 border-radius=6 testId="proc-back"
                    image "symbol:back"
                  text (infoReady ? info.name : "") role="heading" aria-level=1 font="-exact-headline" flex=1 min-width=0 testId="info-name"
                scroll id="process" flex=1 min-height=0 scrollbar-width="none"
                  column gap=10 padding-left=12 padding-right=12 padding-bottom=12
                    if not infoReady
                      column align-items="center" gap=12 padding-top=80 padding-bottom=80
                        progress aria-label="Reading the process"
                    else if not info.found
                      text "This process has quit." color="-exact-secondary-label" text-align="center" padding-top=40 testId="info-gone"
                    else
                      column background-color="light-dark(rgba(0,0,0,0.05), rgba(255,255,255,0.07))" border-radius=12 padding-left=12 padding-right=12
                        Field(label="Process ID", value=`${info.pid}`, first=true, id="info-pid")
                        Field(label="Parent", value=info.parent, first=false, id="info-parent")
                        Field(label="User", value=info.user, first=false, id="info-user")
                        Field(label="% CPU", value=info.cpu, first=false, id="info-cpu")
                        Field(label="CPU Time", value=info.cpuTime, first=false, id="info-cpu-time")
                        Field(label="Threads", value=info.threads, first=false, id="info-threads")
                        Field(label="Memory", value=info.memory, first=false, id="info-memory")
                        Field(label="Real Memory", value=info.realMemory, first=false, id="info-real-memory")
                        if info.running != ""
                          Field(label="Running For", value=info.running, first=false, id="info-running")
                      if info.path != ""
                        text info.path font="-exact-caption1" color="-exact-secondary-label" padding-left=4 padding-right=4 testId="info-path"
                        row gap=8
                          button press=showInFinder(info.path) class=Action testId="info-reveal"
                            text "Show in Finder"
                          button press=copyPath(info.path) class=Action testId="info-copy"
                            text "Copy Path"
                      if endNotice != ""
                        text endNotice font="-exact-footnote" color="-exact-secondary-label" testId="info-notice"
                      // Confirmed here, in the popover: an alert would close it.
                      if ending != ""
                        text (ending == "force" ? `Force quit “${info.name}”? It ends at once, and anything unsaved in it is lost.` : `Quit “${info.name}”?`) font="-exact-footnote" testId="end-confirm-text"
                        row gap=8 justify-content="flex-end"
                          button press=cancelEnd padding-top=7 padding-bottom=7 padding-left=12 padding-right=12 border-radius=8 background-color="light-dark(rgba(0,0,0,0.08), rgba(255,255,255,0.12))" testId="end-cancel"
                            text "Cancel"
                          button press=confirmEnd padding-top=7 padding-bottom=7 padding-left=12 padding-right=12 border-radius=8 background-color="-exact-system-red" testId="end-confirm"
                            text (ending == "force" ? "Force Quit" : "Quit") color="white" font-weight=600
                      else
                        row gap=8
                          button press=askEnd("quit") disabled=(not info.mine or info.own or pending(ended)) flex=1 padding-top=7 padding-bottom=7 border-radius=8 background-color="light-dark(rgba(0,0,0,0.08), rgba(255,255,255,0.12))" align-items="center" justify-content="center" opacity=(info.mine and not info.own ? 1 : 0.5) testId="end-quit"
                            text "Quit"
                          button press=askEnd("force") disabled=(not info.mine or info.own or pending(ended)) flex=1 padding-top=7 padding-bottom=7 border-radius=8 background-color="light-dark(rgba(0,0,0,0.08), rgba(255,255,255,0.12))" align-items="center" justify-content="center" opacity=(info.mine and not info.own ? 1 : 0.5) testId="end-force"
                            text "Force Quit"
                        if info.own
                          text "This is Magnitor. To quit it, use Quit Magnitor." font="-exact-footnote" color="-exact-secondary-label" testId="end-why"
                        else if not info.mine
                          text `${info.name} belongs to ${info.user}. You can quit only your own processes.` font="-exact-footnote" color="-exact-secondary-label" testId="end-why"
            column role="region" id="panel-ports" aria-label="Ports" flex=1 min-height=0 display=(tab == "ports" ? "flex" : "none") flex-direction="column" testId="ports"
              if portPid == -1
                scroll id="ports-list" flex=1 min-height=0 scrollbar-width="none"
                  column gap=10 padding-left=12 padding-right=12 padding-bottom=8
                    if portNotice != ""
                      text portNotice font="-exact-footnote" color="-exact-secondary-label" testId="port-notice"
                    if ports.error != ""
                      text ports.error color="-exact-secondary-label" text-align="center" padding-top=40 testId="ports-error"
                    else if portsReading
                      column align-items="center" gap=12 padding-top=80 padding-bottom=80
                        progress aria-label="Finding servers"
                        text "Finding servers…" color="-exact-secondary-label" testId="ports-reading"
                    else
                      if devServers.length == 0
                        column align-items="center" gap=8 padding-top=48 padding-bottom=24 padding-left=24 padding-right=24
                          image "symbol:sf/network" font="-exact-large-title" color="-exact-tertiary-label" aria-hidden=true
                          text "No development servers running" font="-exact-headline" text-align="center" testId="ports-empty"
                          text "Start one, such as npm run dev, and it appears here with its port, ready to open or stop." font="-exact-footnote" color="-exact-secondary-label" text-align="center"
                      else
                        column gap=6
                          text "Development" font="-exact-subheadline" font-weight=600 color="-exact-secondary-label" padding-left=4
                          column background-color="light-dark(rgba(0,0,0,0.05), rgba(255,255,255,0.07))" border-radius=12 padding-left=10 padding-right=6
                            for s, i in devServers key=`${s.pid}:${s.port}`
                              PortRow(server=s, first=(i == 0), lit=(portKey(s) == portSelected), id=`port-${i}`, open=openPort(s.pid, s.port), aim=aimPort(s.pid, s.port), browse=openLink(s.url), stop=stopServer(s.pid, s.port, false))
                      if otherServers.length > 0
                        column gap=6
                          button press=toggleOthers aria-expanded=othersShown display="flex" flex-direction="row" gap=6 align-items="center" padding-left=4 padding-right=4 testId="others-toggle"
                            text "Other Ports" font="-exact-subheadline" font-weight=600 color="-exact-secondary-label"
                            text `${otherServers.length}` font="-exact-caption1" color="-exact-tertiary-label" font-variant-numeric="tabular-nums" testId="others-count"
                            column flex=1
                            image (othersShown ? "symbol:sf/chevron.down" : "symbol:forward-chevron") font="-exact-caption1" color="-exact-tertiary-label" aria-hidden=true
                          if othersShown
                            column background-color="light-dark(rgba(0,0,0,0.05), rgba(255,255,255,0.07))" border-radius=12 padding-left=10 padding-right=6
                              for s, i in otherServers key=`${s.pid}:${s.port}`
                                PortRow(server=s, first=(i == 0), lit=(portKey(s) == portSelected), id=`other-${i}`, open=openPort(s.pid, s.port), aim=aimPort(s.pid, s.port), browse=openLink(s.url), stop=stopServer(s.pid, s.port, false))
                      text "Lists the ports your own processes opened. macOS’s own services need an administrator to see." font="-exact-caption1" color="-exact-tertiary-label" text-align="center" padding-top=4 testId="ports-note"
                    // A row's actions, as Activity's: a right-click opens them at the pointer.
                    column id="port-menu" popover="auto" role="menu" aria-label="Server" testId="port-menu"
                      for s in aimedServer key=`${s.pid}:${s.port}`
                        button id="port-menu-first" press=openPort(s.pid, s.port) popovertarget="port-menu" popovertargetaction="hide" testId="port-menu-info"
                          text "Show Details"
                        if s.url != ""
                          button press=openLink(s.url) popovertarget="port-menu" popovertargetaction="hide" testId="port-menu-open"
                            text "Open in Browser"
                          button press=copyUrl(s.url) popovertarget="port-menu" popovertargetaction="hide" testId="port-menu-copy-url"
                            text "Copy URL"
                        if s.dir != ""
                          button press=showInFinder(s.dir) popovertarget="port-menu" popovertargetaction="hide" testId="port-menu-reveal"
                            text "Show Folder in Finder"
                        button press=copyCommand(s.command) popovertarget="port-menu" popovertargetaction="hide" testId="port-menu-copy-command"
                          text "Copy Command"
                        hr
                        button press=stopServer(s.pid, s.port, false) popovertarget="port-menu" popovertargetaction="hide" testId="port-menu-stop"
                          text "Stop"
                        button press=stopServer(s.pid, s.port, true) destructive=true popovertarget="port-menu" popovertargetaction="hide" testId="port-menu-force"
                          text "Force Stop"
              else
                // One server: its port as the screen's number, where it listens, what runs it.
                row align-items="center" gap=6 padding-left=8 padding-right=16 padding-bottom=6
                  button press=closePort aria-label="Back" padding=6 border-radius=6 testId="port-back"
                    image "symbol:back"
                  text openedServer.map(s => s.name).join("") role="heading" aria-level=1 font="-exact-headline" flex=1 min-width=0 testId="port-title"
                scroll id="port" flex=1 min-height=0 scrollbar-width="none"
                  column gap=10 padding-left=12 padding-right=12 padding-bottom=12
                    if openedServer.length == 0
                      text "This server has stopped." color="-exact-secondary-label" text-align="center" padding-top=40 testId="port-gone"
                      if portNotice != ""
                        text portNotice font="-exact-footnote" color="-exact-secondary-label" text-align="center" testId="port-detail-notice"
                    for s in openedServer key=`${s.pid}:${s.port}`
                      column align-items="center" gap=2 padding-top=4 padding-bottom=4
                        text `${s.port}` font="-exact-large-title" font-weight=700 font-variant-numeric="tabular-nums" color="-exact-system-blue" testId="port-number"
                        text (s.url != "" ? s.url.replaceAll("http://", "") : "Port") font="-exact-footnote" color="-exact-secondary-label" testId="port-url"
                      if s.exposed
                        row gap=6 align-items="flex-start" padding=10 border-radius=10 background-color="light-dark(rgba(255,149,0,0.12), rgba(255,159,10,0.18))" testId="port-exposed-note"
                          image "symbol:sf/exclamationmark.triangle.fill" font="-exact-footnote" color="-exact-system-orange" aria-hidden=true
                          text "Open to your network: other devices on this Wi‑Fi can reach it. Bind it to localhost to keep it on this Mac." font="-exact-footnote" flex=1
                      column background-color="light-dark(rgba(0,0,0,0.05), rgba(255,255,255,0.07))" border-radius=12 padding-left=12 padding-right=12
                        Field(label="Address", value=(s.exposed ? "All interfaces" : "This Mac only"), first=true, id="port-address")
                        Field(label="Process", value=`${s.process} (${s.pid})`, first=false, id="port-process")
                        if s.image != ""
                          Field(label="Image", value=s.image, first=false, id="port-image")
                        if s.running != ""
                          Field(label="Running For", value=s.running, first=false, id="port-running")
                        if s.folder != ""
                          Field(label="Folder", value=s.folder, first=false, id="port-folder")
                      text s.command font="-exact-caption1" color="-exact-secondary-label" padding-left=4 padding-right=4 testId="port-command"
                      if s.url != ""
                        row gap=8
                          button press=openLink(s.url) class=Action testId="port-open"
                            text "Open in Browser"
                          button press=copyUrl(s.url) class=Action testId="port-copy-url"
                            text "Copy URL"
                      row gap=8
                        if s.dir != ""
                          button press=showInFinder(s.dir) class=Action testId="port-reveal"
                            text "Show in Finder"
                        button press=copyCommand(s.command) class=Action testId="port-copy-command"
                          text "Copy Command"
                      if portNotice != ""
                        text portNotice font="-exact-footnote" color="-exact-secondary-label" testId="port-detail-notice"
                      // Confirmed here, in the popover: an alert would close it.
                      if portEnding != ""
                        text portEndText(portEnding, s) font="-exact-footnote" testId="port-confirm-text"
                        row gap=8 justify-content="flex-end"
                          button press=cancelPortEnd padding-top=7 padding-bottom=7 padding-left=12 padding-right=12 border-radius=8 background-color="light-dark(rgba(0,0,0,0.08), rgba(255,255,255,0.12))" testId="port-cancel"
                            text "Cancel"
                          button press=confirmPortEnd padding-top=7 padding-bottom=7 padding-left=12 padding-right=12 border-radius=8 background-color="-exact-system-red" testId="port-confirm"
                            text (portEnding == "force" ? "Force Stop" : "Stop") color="white" font-weight=600
                      else
                        row gap=8
                          button press=askPortEnd("stop") disabled=pending(portStopped) class=Action testId="port-stop"
                            text "Stop"
                          button press=askPortEnd("force") disabled=pending(portStopped) class=Action testId="port-force"
                            text "Force Stop"
            // Settings (⌘,: the Mac's Settings window) and Quit.
            row padding-left=8 padding-right=12 padding-top=4 padding-bottom=10 align-items="center"
              link href="/settings" target="settings" aria-keyshortcuts="Meta+," aria-label="Settings" padding=4 border-radius=6 color="-exact-secondary-label" testId="open-settings"
                image "symbol:settings"
              column flex=1 align-items="center"
                // A new version that this copy can install: Settings has Install and Relaunch.
                if update.available and update.canInstall
                  link href="/settings" target="settings" padding=4 testId="update-available"
                    text `Update to ${update.latest}` font="-exact-footnote" font-weight=600 color="-exact-system-blue"
              button press=quit aria-keyshortcuts="Meta+Q" padding=4 testId="quit"
                text "Quit Magnitor" font="-exact-footnote" color="-exact-secondary-label"
        if e.name == "settings"
          column navigationKey=`${e.id}` navigationScroll="settings-form" position="absolute" inset=0 display="flex" flex-direction="column" testId="settings"
            header display="flex" align-items="center"
              text "Settings" role="heading" aria-level=1 flex=1
              // In a window of its own on the Mac; elsewhere Settings is a screen over the app.
              if not inWindow
                button press=closeSettings testId="settings-done"
                  text "Done"
            // The folder pickers' answers (Developer Files' folders).
            input id="scan-add" display="none" change=pickedScanFolder
            input id="scan-skip" display="none" change=pickedScanSkip
            list id="settings-form" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
              section
                header
                  text "Keyboard Shortcut"
                row
                  text "Open Magnitor"
                  row gap=6 align-items="center"
                    button id="hotkey" tabindex=0 buttonStyle="bordered" press=record key=recordKey blur=stopRecording aria-label=(hotkey == "" ? "Record Shortcut" : `Shortcut ${chordText(hotkey)}. Record another`) testId="hotkey"
                      text (recording ? "Type Shortcut…" : hotkey == "" ? "Record Shortcut" : chordText(hotkey))
                    if hotkey != "" and not recording
                      button press=clearHotkey aria-label="Clear Shortcut" testId="hotkey-clear"
                        image "symbol:close"
                footer
                  text hotkeyFooter testId="hotkey-note"
              section
                header
                  text "Menu Bar"
                row
                  text "Show"
                  select value=trayShow change=setTrayShow aria-label="Menu bar item shows" testId="tray-show"
                    option "Icon" value="icon"
                    option "CPU Usage" value="cpu"
                    option "CPU and Memory" value="both"
                if trayShow == "icon"
                  row
                    text "Icon"
                    row role="radiogroup" aria-label="Menu bar icon" testId="tray-icon"
                      for icon in ["waveform", "gauge", "cpu", "memory", "disk", "chart"] key=icon
                        button role="radio" aria-checked=(trayIcon == icon) press=setTrayIcon(icon) aria-label=trayIconName(icon) testId=`tray-icon-${icon}`
                          image trayIconSymbol(icon)
                footer
                  text (trayShow == "icon" ? "The icon Magnitor shows in the menu bar." : "The menu bar shows your Mac’s load, read every two seconds.") testId="tray-note"
              section
                header
                  text "Activity Monitor"
                row
                  text "Update Every"
                  select value=`${refresh}` change=setRefresh aria-label="Update Activity Monitor every" testId="refresh"
                    for n in [1, 2, 3, 5] key=n
                      option sustainText(n) value=`${n}`
                footer
                  text "How often the process list reads your Mac while it’s open. Less often uses less CPU." testId="refresh-note"
              section
                header
                  text "Desktop Widget"
                row
                  text "Keep Widget Up to Date"
                  input type="checkbox" switch checked=widgetOn change=setWidgetOn aria-label="Keep Widget Up to Date" testId="widget-on"
                row
                  text "Shows"
                  select value=widgetShows change=setWidgetShows disabled=(not widgetOn) aria-label="Widget shows" testId="widget-shows"
                    option "CPU, Memory and Disk" value="all"
                    option "CPU and Memory" value="system"
                    option "Disk Space" value="disk"
                row justify-content="center"
                  // The widget as the desktop shows it, at the small size.
                  column width=158 height=158 padding=14 border-radius=22 background-color="-exact-secondary-background" aria-label="Widget preview" testId="widget-preview"
                    VitalsWidget(shows=widgetPreview.shows, cpu=widgetPreview.cpu, memory=widgetPreview.memory, pressure=widgetPreview.pressure, free=widgetPreview.free, freeShare=widgetPreview.freeShare, updated=widgetPreview.updated, ready=widgetPreview.ready)
                footer
                  text "To add the widget, Control-click the desktop, choose Edit Widgets, then find Magnitor. Magnitor updates it each minute while it runs." testId="widget-note"
              section
                header
                  text "Alerts"
                row
                  text "Notify Me"
                  input type="checkbox" switch checked=alertsOn change=setAlertsOn aria-label="Notify Me" testId="alerts-on"
                row
                  text "CPU Over"
                  select value=`${cpuLimit}` change=setCpuLimit disabled=(not alertsOn) aria-label="CPU over" testId="cpu-limit"
                    for n in [0, 50, 70, 80, 90, 95] key=n
                      option limitText(n) value=`${n}`
                row
                  text "Memory Over"
                  select value=`${memoryLimit}` change=setMemoryLimit disabled=(not alertsOn) aria-label="Memory over" testId="memory-limit"
                    for n in [0, 70, 80, 90, 95] key=n
                      option limitText(n) value=`${n}`
                row
                  text "Free Disk Under"
                  select value=`${diskLimit}` change=setDiskLimit disabled=(not alertsOn) aria-label="Free disk space under" testId="disk-limit"
                    for n in [0, 5, 10, 20, 50] key=n
                      option diskLimitText(n) value=`${n}`
                row
                  text "For at Least"
                  select value=`${sustain}` change=setSustain disabled=(not alertsOn) aria-label="For at least" testId="sustain"
                    for n in [10, 30, 60, 300] key=n
                      option sustainText(n) value=`${n}`
                row
                  text "One Process Over"
                  select value=`${procCpuLimit}` change=setProcCpuLimit disabled=(not alertsOn) aria-label="One process's CPU over" testId="proc-cpu-limit"
                    for n in [0, 80, 100, 200, 400] key=n
                      option limitText(n) value=`${n}`
                row
                  text "Busy For"
                  select value=`${procBusyFor}` change=setProcBusyFor disabled=(not alertsOn or procCpuLimit == 0) aria-label="One process busy for" testId="proc-busy-for"
                    for n in [60, 120, 300, 600, 1800] key=n
                      option sustainText(n) value=`${n}`
                row
                  text "Memory Grows By"
                  select value=`${procGrowLimit}` change=setProcGrowLimit disabled=(not alertsOn) aria-label="One process's memory grows by, in ten minutes" testId="proc-grow-limit"
                    for n in [0, 1, 2, 4] key=n
                      option diskLimitText(n) value=`${n}`
                row
                  text "Developer Files Over"
                  select value=`${cleanRemind}` change=setCleanRemind disabled=(not alertsOn) aria-label="Remind me monthly when developer files to clean up are over" testId="clean-remind"
                    for n in [0, 5, 10, 20, 50] key=n
                      option diskLimitText(n) value=`${n}`
                row
                  button press=testAlert disabled=(not alertsOn or notifying.state == "denied") testId="test-alert"
                    text "Send Test Notification"
                footer
                  text alertsNote testId="alerts-note"
              section
                header
                  text "Developer Files"
                for f, n in scanFolders key=f
                  row
                    text f flex=1 min-width=0 text-overflow="ellipsis" white-space="nowrap" overflow="hidden" testId=`scan-folder-${n}`
                    button press=removeScanFolder(f) aria-label=`Stop looking in ${f}` testId=`scan-folder-${n}-remove`
                      image "symbol:minus-circle"
                row
                  button press=addScanFolder testId="scan-add-button"
                    text "Also Look In…"
                for f, n in scanSkip key=f
                  row
                    text `Not in ${f}` flex=1 min-width=0 text-overflow="ellipsis" white-space="nowrap" overflow="hidden" testId=`scan-skip-${n}`
                    button press=removeScanSkip(f) aria-label=`Look in ${f} again` testId=`scan-skip-${n}-remove`
                      image "symbol:minus-circle"
                row
                  button press=addScanSkip testId="scan-skip-button"
                    text "Leave Out a Folder…"
                footer
                  text "Magnitor looks for build folders in your home folder. Add folders on other drives, or leave out ones it shouldn’t touch." testId="scan-note"
              section
                header
                  text "Updates"
                row
                  text "Check Automatically"
                  input type="checkbox" switch checked=autoUpdate change=setAutoUpdate aria-label="Check for Updates Automatically" testId="update-auto"
                row
                  text updateStatus flex=1 testId="update-status"
                  if update.available and update.canInstall
                    button press=installUpdate disabled=updating buttonStyle="filled" testId="update-install"
                      text (updating ? "Installing…" : "Install and Relaunch")
                  else
                    button press=recheckUpdate disabled=(not current(update)) testId="update-check"
                      text "Check Now"
                footer
                  text updateFooter testId="update-note"

// A label and its value, a row of the process inspector.
component Field
  props
    label: string
    value: string
    first: bool
    id: string
  view
    row gap=12 align-items="baseline" padding-top=7 padding-bottom=7 border-top=(first ? "none" : "1px solid -exact-separator")
      text label color="-exact-secondary-label"
      text value flex=1 min-width=0 text-align="right" font-variant-numeric="tabular-nums" text-overflow="ellipsis" white-space="nowrap" overflow="hidden" testId=id

// A server's row in Ports: its port as the row's number, what runs it and where, and Open in
// Browser and Stop at its end. A right-click opens its actions (`port-menu`).
component PortRow
  props
    server: Server
    first: bool
    // Highlighted by the list's keys (↑ ↓).
    lit: bool
    id: string
    open: action
    aim: action
    browse: action
    stop: action
  view
    row gap=4 align-items="center" padding-top=7 padding-bottom=7 border-top=(first ? "none" : "1px solid -exact-separator") testId=id
      button id=`port-row-${server.pid}-${server.port}` press=open contextmenu=aim contextPopover="port-menu" aria-label=portLabel(server) display="flex" flex-direction="row" gap=8 align-items="center" flex=1 min-width=0 margin-left=-6 padding-left=6 border-radius=6 background-color=(lit ? "light-dark(rgba(0,0,0,0.08), rgba(255,255,255,0.1))" : "transparent") testId=`${id}-open`
        text `${server.port}` font="-exact-headline" font-weight=700 font-variant-numeric="tabular-nums" color=(server.dev ? "-exact-system-blue" : "-exact-secondary-label") width="3.4rem" flex-shrink=0 text-align="left" testId=`${id}-port`
        column flex=1 min-width=0 gap=1 text-align="left"
          text server.name text-overflow="ellipsis" white-space="nowrap" overflow="hidden" testId=`${id}-name`
          text portDetail(server) font="-exact-caption1" color="-exact-secondary-label" text-overflow="ellipsis" white-space="nowrap" overflow="hidden" testId=`${id}-detail`
          if server.exposed
            row gap=3 align-items="center"
              image "symbol:sf/wifi" font="-exact-caption2" color="-exact-system-orange" aria-hidden=true
              text "Open to your network" font="-exact-caption2" color="-exact-system-orange" testId=`${id}-exposed`
      if server.url != ""
        button press=browse aria-label=`Open ${server.url} in your browser` padding=6 border-radius=6 color="-exact-secondary-label" testId=`${id}-browse`
          image "symbol:sf/safari"
      if server.dev
        button press=stop aria-label=`Stop ${server.name} on port ${server.port}` padding=6 border-radius=6 color="-exact-secondary-label" testId=`${id}-stop`
          image "symbol:sf/stop.circle"

// A developer file's row: its checkbox, what it is and where, its size, and Show in Finder.
component DevRow
  props
    item: DevItem
    on: bool
    first: bool
    id: string
    // `choose` takes the checkbox's new value.
    choose: action
    reveal: action
  view
    row gap=10 align-items="center" padding-top=8 padding-bottom=8 border-top=(first ? "none" : "1px solid -exact-separator") testId=id
      input type="checkbox" checked=on change=choose aria-label=devLabel(item) testId=`${id}-check`
      column flex=1 min-width=0 gap=1
        row gap=8 align-items="baseline"
          text item.name font-weight=500 flex=1 min-width=0 text-overflow="ellipsis" white-space="nowrap" overflow="hidden" testId=`${id}-name`
          text item.size font-variant-numeric="tabular-nums" testId=`${id}-size`
        text devPlace(item) font="-exact-caption1" color="-exact-secondary-label" text-overflow="ellipsis" white-space="nowrap" overflow="hidden" testId=`${id}-place`
        if item.note != ""
          row gap=4 align-items="center"
            image "symbol:sf/exclamationmark.triangle.fill" font="-exact-caption2" color="-exact-system-orange" aria-hidden=true
            text item.note font="-exact-caption2" color="-exact-system-orange" testId=`${id}-note`
        else if item.age != ""
          text item.age font="-exact-caption2" color="-exact-tertiary-label" testId=`${id}-age`
      button press=reveal aria-label=`Show ${item.name} in Finder` padding=6 border-radius=6 color="-exact-secondary-label" testId=`${id}-reveal`
        image "symbol:search"

// A tool's command in Developer Files: what it frees and how, with Run (asked first in the
// footer) or, when Magnitor can't run it here, Copy.
component CommandRow
  props
    cmd: DevCommand
    first: bool
    id: string
    run: action
    copy: action
  view
    column gap=3 padding-top=8 padding-bottom=8 border-top=(first ? "none" : "1px solid -exact-separator") testId=id
      row gap=8 align-items="baseline"
        text cmd.name font-weight=500 flex=1 min-width=0 testId=`${id}-name`
        if cmd.size != ""
          text cmd.size font-variant-numeric="tabular-nums" testId=`${id}-size`
      text cmd.detail font="-exact-caption1" color="-exact-secondary-label" testId=`${id}-detail`
      if cmd.note != ""
        text cmd.note font="-exact-caption2" color="-exact-system-orange" testId=`${id}-note`
      row gap=8 align-items="center" padding-top=2
        text cmd.command font="-exact-caption1" font-family="ui-monospace, monospace" color="-exact-secondary-label" flex=1 min-width=0 testId=`${id}-command`
        if cmd.available
          button press=run padding-top=4 padding-bottom=4 padding-left=10 padding-right=10 border-radius=6 background-color="light-dark(rgba(0,0,0,0.08), rgba(255,255,255,0.12))" aria-label=`Run ${cmd.command}` testId=`${id}-run`
            text "Run…" font="-exact-footnote" font-weight=500
        else
          button press=copy padding-top=4 padding-bottom=4 padding-left=10 padding-right=10 border-radius=6 background-color="light-dark(rgba(0,0,0,0.08), rgba(255,255,255,0.12))" aria-label=`Copy ${cmd.command}` testId=`${id}-copy`
            text "Copy" font="-exact-footnote" font-weight=500

// The icon `procIcons` holds for row `i` ("" until it lands).
fn iconAt(icons: AppIcon[], i: number): string = match icons.at(i) { case some(a) => a.icon, case none => "" }

// A process's icon: its app's, or a gear for a process outside an app; an empty square while
// its app's icon is still on the way.
component ProcIcon
  props
    app: string
    icon: string
    id: string
  view
    if icon != ""
      image icon width=20 height=20 flex-shrink=0 aria-hidden=true testId=id
    else
      column width=20 height=20 flex-shrink=0 align-items="center" justify-content="center" aria-hidden=true
        if app == ""
          image "symbol:settings" font="-exact-title3" color="-exact-tertiary-label"

// The desktop widget (app.json's `widgets`): the main window's last reading of the machine.
component VitalsWidget
  props
    shows: string
    cpu: number
    memory: number
    pressure: string
    free: string
    freeShare: number
    updated: string
    ready: bool
  view
    column gap=8 flex=1 justify-content="center" testId="widget"
      if not ready
        image "symbol:activity" width=28 height=28 color="-exact-secondary-label" aria-hidden=true
        text "Open Magnitor to see your Mac’s load here." font="-exact-footnote" color="-exact-secondary-label" testId="widget-empty"
      else
        if shows != "disk"
          Meter(label="CPU", value=`${round(cpu)}%`, share=cpu / 100, tint="blue", id="widget-cpu")
          Meter(label="Memory", value=`${round(memory)}%`, share=memory / 100, tint=(pressure == "Critical" ? "red" : pressure == "Warning" ? "yellow" : "green"), id="widget-memory")
        if shows != "system" and free != ""
          Meter(label="Disk", value=`${free} free`, share=1 - freeShare, tint="purple", id="widget-disk")
        text updated font="-exact-caption2" color="-exact-tertiary-label" testId="widget-updated"

// A labelled share and its bar, a row of the widget.
component Meter
  props
    label: string
    value: string
    share: number
    // "blue", "green", "yellow", "red" or "purple": the system colour of that name.
    tint: string
    id: string
  view
    column gap=3
      row gap=6 align-items="baseline"
        text label font="-exact-caption1" font-weight=600 color="-exact-secondary-label" flex=1
        text value font="-exact-caption1" font-variant-numeric="tabular-nums" testId=id
      column height=5 border-radius=3 background-color="light-dark(rgba(0,0,0,0.08), rgba(255,255,255,0.12))" overflow="hidden" aria-hidden=true
        column width=`${max(0, min(1, share)) * 100}%` height=5 background-color=(tint == "red" ? "-exact-system-red" : tint == "yellow" ? "-exact-system-yellow" : tint == "green" ? "-exact-system-green" : tint == "purple" ? "-exact-system-purple" : "-exact-system-blue")
