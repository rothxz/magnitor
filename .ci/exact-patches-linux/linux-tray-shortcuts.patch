+            .collect()
+    }
+
+    #[test]
+    fn the_arrow_points_from_the_page_to_the_item() {
+        let up = draw((40., false), 9);
+        eprintln!("{}", up.join("\n"));
+        // The tip at the item, nothing beside it; the corners stay round.
+        assert_eq!(&up[0][..38], &".".repeat(38));
+        assert_ne!(up[1].as_bytes()[40], b'.');
+        assert_eq!(up[1].as_bytes()[20], b'.');
+        assert_eq!(up[29].as_bytes()[0], b'.');
+        assert_eq!(up[9].as_bytes()[0], b'.');
+        let down = draw((20., true), 0);
+        eprintln!("{}", down.join("\n"));
+        assert_ne!(down[28].as_bytes()[20], b'.');
+        assert_eq!(down[28].as_bytes()[45], b'.');
+        assert_eq!(down[0].as_bytes()[0], b'.');
+    }
+
+    #[test]
+    fn no_border_runs_across_the_arrow_base() {
+        let (width, height) = (60u32, 30u32);
+        let rgba = vec![0xffu8; (width * 21 * 4) as usize];
+        let mut out = vec![0u32; (width * height) as usize];
+        popup_pixels(&mut out, &rgba, (width, height), 9, 1., [0, 0, 0], Some((40., false)));
+        // The page's first row under the tip is the page's white, not border.
+        assert_eq!(out[(9 * width + 40) as usize], 0xffff_ffff);
+        assert_ne!(out[(9 * width + 10) as usize] & 0xff, 0xff);
+    }
+}
